<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="NumberGame2Section" type="Fanex.HttpModule.NG2.UM.Configurations.NumberGame2Section, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral" />
  <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" /><section name="ONEbook.UM.ThirdParty" type="ONEbook.UM.ThirdParty.Configurations.UMClientConfiguration, ONEbook.UM.ThirdParty" /></configSections>
  <NumberGame2Section configSource="Configurations\NumberGame2Section.config" />
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="NG2HttpModule" />
      <add name="NG2HttpModule" type="Fanex.HttpModule.NG2.UM.Web.NG2HttpModule" preCondition="integratedMode" />
    </modules>
  </system.webServer>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" /></startup><Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" /><ONEbook.UM.ThirdParty ServiceUris="http://10.18.200.124:8887/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" UMPageUrl="~/UserLogin/Common/Offline"> 
    <Products>
      <add Id="23" IsUM="false" UMFrom="00:00" UMTo="01:00" /> <!--For manual control on site each product -->
    </Products>
  </ONEbook.UM.ThirdParty></configuration>
