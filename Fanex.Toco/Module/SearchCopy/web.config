<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
  <section name="ONEbook.UM.ThirdParty" type="ONEbook.UM.ThirdParty.Configurations.UMClientConfiguration, ONEbook.UM.ThirdParty" /></configSections>
  <system.web>
    <compilation debug="true" targetFramework="4.0" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.5.0.0" newVersion="4.5.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
<ONEbook.UM.ThirdParty ServiceUris="http://10.18.200.124:8887/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" UMPageUrl="~/UserLogin/Common/Offline"> 
    <Products>
      <add Id="23" IsUM="false" UMFrom="00:00" UMTo="01:00" /> <!--For manual control on site each product -->
    </Products>
  </ONEbook.UM.ThirdParty></configuration>