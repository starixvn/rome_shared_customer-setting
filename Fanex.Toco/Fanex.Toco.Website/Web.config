<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=152368
  -->
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
    <section name="ProgressiveSection" type="Fanex.CustomerSetting.Module.ProgressiveBonus.Configurations.ProgressiveSection, Fanex.CustomerSetting.Module.ProgressiveBonus, Version=1.0.0.0, Culture=neutral"/>

    <!--Sportsbook-->
    <section name="PTMappingSection" type="Fanex.PTEngine.XmlMapping.PTMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <section name="BettingLimitMappingSection" type="Fanex.PTEngine.XmlMapping.BettingLimitMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <!--/Sportsbook-->

   <!--Bingo-->
    <section name="unity" type="Microsoft.Practices.Unity.Configuration.UnityConfigurationSection, Microsoft.Practices.Unity.Configuration, Version=2.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
    <section name="Sunplus.Bingo" type="Sunplus.Bingo.Core.Configuration.BingoConfigurationSection, Sunplus.Bingo.Core"/>
    <!--/End Bingo-->
    
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=4.4.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core"/>

    <sectionGroup name="CustomerSetting">
      <section name="Security" type="Fanex.CustomerSetting.Security.Configurations.CustomerSettingSection, Fanex.CustomerSetting.Security"/>
    </sectionGroup>

    <!--RacingSetting-->
    <section name="PTRacingMappingSection" type="Fanex.PTRacing.XmlMapping.PTRacingMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <section name="RacingBettingCommSettingMappingSection" type="Fanex.PTRacing.XmlMapping.RacingBettingCommSettingMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <!--/RacingSetting-->
    
  </configSections>

  <!--RacingSetting-->
  <PTRacingMappingSection configSource="Web.Configuration\CustomerSetting\Racing\PTRacingMappingSection.config"/>
  <RacingBettingCommSettingMappingSection configSource="Web.Configuration\CustomerSetting\Racing\RacingBettingCommSettingMappingSection.config"/>
  <!--/RacingSetting-->
  
  <!--Bingo-->
  <Sunplus.Bingo MaxPt="0.9" MinPt="0.0" MaxCommission="0.0025" MaxBall="75">
    <BingoGame EnabledMaxTransfer="true" Enabled="true" CodeGameNo="01"/>
    <NumberGame Enabled="true" NoneLiveBettypes="81^1st ball Over/ Under,82^Last ball Over/ Under,83^1st ball Odd/ Even,84^Last ball Odd/ Even,88^FT. Warrior,86^FT. Odd/ Even" LiveBettypes="85^Next Over/ Under,86^Next Odd/ Even,87^Next Hight/ Low,89^Next Combo, 90^Number Group"/>
  </Sunplus.Bingo>
  <!--End Bingo-->
  <!--Bingo API-->
  <unity>
    <typeAliases>
      <!-- Lifetime manager types -->
      <typeAlias alias="singleton" type="Microsoft.Practices.Unity.ContainerControlledLifetimeManager, Microsoft.Practices.Unity"/>
      <typeAlias alias="external" type="Microsoft.Practices.Unity.ExternallyControlledLifetimeManager, Microsoft.Practices.Unity"/>
      <!-- Custom object types -->
      <typeAlias alias="ICustomerService" type="Sunplus.Bingo.Services.ICustomerService, Sunplus.Bingo.Services"/>
      <typeAlias alias="CustomerService" type="Sunplus.Bingo.Services.CustomerService, Sunplus.Bingo.Services"/>
      <typeAlias alias="IReportService" type="Sunplus.Bingo.Services.IReportService, Sunplus.Bingo.Services"/>
      <typeAlias alias="ReportService" type="Sunplus.Bingo.Services.ReportService, Sunplus.Bingo.Services"/>
      <typeAlias alias="ICustomerDAO" type="Sunplus.Bingo.Data.ICustomerDAO, Sunplus.Bingo.Data"/>
      <typeAlias alias="IReportDAO" type="Sunplus.Bingo.Data.IReportDAO, Sunplus.Bingo.Data"/>
      <typeAlias alias="ILogger" type="Sunplus.Core.LoggingLib.ILogger, Sunplus.Core.LoggingLib"/>
      <typeAlias alias="LinqCustomerDAO" type="Sunplus.Bingo.Data.LinqToSql.LinqCustomerDAO, Sunplus.Bingo.Data.LinqToSql"/>
      <typeAlias alias="LinqReportDAO" type="Sunplus.Bingo.Data.LinqToSql.LinqReportDAO, Sunplus.Bingo.Data.LinqToSql"/>
      <typeAlias alias="EntLibLogger" type="Sunplus.Core.LoggingLib.EntLibLogger, Sunplus.Core.LoggingLib"/>
    </typeAliases>
    <containers>
      <container name="BingoContainer">
        <types>
          <type type="ICustomerService" mapTo="CustomerService"/>
          <type type="IReportService" mapTo="ReportService"/>
          <type type="ICustomerDAO" mapTo="LinqCustomerDAO"/>
          <type type="IReportDAO" mapTo="LinqReportDAO"/>
          <type type="ILogger" mapTo="EntLibLogger"/>
        </types>
      </container>
    </containers>
  </unity>

  <CustomerSetting>
    <Security allowDirectDownline="false" allowGroups="222|" authenticateFactory="Fanex.CustomerSetting.Security.Authenticate.DefaultAuthenticate, Fanex.CustomerSetting.Security"/>
  </CustomerSetting>

  

  <ProgressiveSection configSource="Web.Configuration\ProgressiveSection.config"/>

  <!--Sportsbook-->
  <PTMappingSection configSource="PTEngine\PTMappingSection.config"/>
  <BettingLimitMappingSection configSource="PTEngine\BettingLimitMappingSection.config"/>
  <!--/Sportsbook-->

  
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider2, Fanex.Data" resourcePath="~/Web.Configuration/Store/" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>

  <connectionStrings>
