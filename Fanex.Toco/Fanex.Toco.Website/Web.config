  <LogsConfiguration configSource="Areas\Logs\LogsConfiguration.config" />
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.124\private$\entlib" defaultCategory="Toco-Credit-Setting" />
  <CustomerSetting>
    <Security allowDirectDownline="false" allowGroups="222|1" authenticateFactory="Fanex.CustomerSetting.Security.Authenticate.DefaultAuthenticate, Fanex.CustomerSetting.Security" />
    <Keno enable="true" showsetting="true" exclude="1501,1502" excludesetting="1515" />
    <Casino IsUMTime="false" UMFrom="12:30PM" UMTo="14:00PM" />
  </CustomerSetting>
  <CurrentSession sessionFactory="Fanex.CustomerSetting.Module.Core.Web.CurrentSession, Fanex.CustomerSetting.Module.Core" />
