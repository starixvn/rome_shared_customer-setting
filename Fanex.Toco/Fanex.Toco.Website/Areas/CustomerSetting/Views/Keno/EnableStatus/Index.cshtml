@using Fanex.CustomerSetting.Module.KenoStatus.Resources
@{
    string hide = ViewBag.roleId == 1 ? "true" : "false";
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/Keno/EnableStatus/Styles/Enablekeno.css")" rel="stylesheet" type="text/css" />
<div id="ng-app" data-ng-app="kenoStatusApp" data-ng-controller="KenoStatusController" data-ng-init="Init()" style="display: none; width: 96%">
    <div id="errMsg" style="display: none" class="successMsg">
    </div>
    <table class="tableInfo" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td colspan="2" class="bold enableTitle">
                <div>
                    <div style="float: left">
                        <input data-ng-disabled="isDisabledAll"  id="chkAll" type="checkbox" data-ng-click="CheckAll()" />@ViewLang.All
                    </div>
                    <div style="text-align: center">{{model.roleID == 4 ? '@ViewLang.Super: ' : model.roleID == 3 ? '@ViewLang.Master: ' : model.roleID == 2 ? '@ViewLang.Agent: ' : '@ViewLang.Member: '}}&nbsp;{{model.userName}}</div>
                </div>
            </td>
        </tr>
        <tr data-ng-repeat="item in betTypes" data-ng-hide="item.isHide" data-ng-init="item.disable = false; item.enable = !item.isDisabled; item.preVal = item.enable; item.disableDownline = true; item.enableDownline = !item.isDisabledDownlines; item.preValDownline = item.enableDownline">
            <td style="width: 50%">
                <input name="betTypes0" type="checkbox" data-ng-click="item.disable = !item.enable; item.isDisabledDownlines = !item.enableDownline; CheckStatus({{item.preVal}}, this)" data-ng-model="item.enable" data-ng-disabled="item.isDisabledUpline" /><span>{{item.betTypeName}}</span>
            </td>
            <td>
                <input name="betTypes1" data-ng-hide="@hide" type="checkbox" data-ng-change="item.disableDownlines = !item.enableDownline" data-ng-model="item.enableDownline" data-ng-disabled="item.disableDownline" /><span data-ng-hide="@hide">@Fanex.CustomerSetting.Module.Keno.Resources.LayoutTexts.EnableDownlines</span>
            </td>
        </tr>
    </table>
    <div style="text-align: right" >
        <input class="buttonPopup" data-ng-disabled="isDisabledAll"  type="button" value="@ViewLang.Submit" data-ng-click="Update()" style="margin-right: 0" />
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/CustomerSetting/Keno/EnableStatus/GetKenoStatusData?id=" + ViewBag.id + "&uplineId=" + (ViewBag.roleId == 4 ? 0 : ViewBag.uplineId) + "&roleId=" + ViewBag.roleId + "&subAccountId=" + ViewBag.subAccountId)" type="text/javascript"></script>
<script type="text/javascript">
    var custId = parseInt('@ViewBag.id');
    var uplineId = parseInt('@ViewBag.uplineId');
    var roleId = parseInt('@ViewBag.roleId');
    var successMsg = '@Fanex.CustomerSetting.Module.Keno.Resources.Messages.UpdatedSuccess';

    function resolveClientUrl(url) {
        return '@Url.Content("~/")' + url;
    }
</script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/EnableStatus/Scripts/KenoStatusController.js?ver=1")" type="text/javascript"></script>
