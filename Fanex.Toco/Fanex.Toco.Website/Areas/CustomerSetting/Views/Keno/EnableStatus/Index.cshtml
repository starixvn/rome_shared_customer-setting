@*@using Fanex.ExternalAccount.Utilities*@
@{
    string hide = ViewBag.roleId == 1 ? "true" : "false";
}
@*<link href="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Styles/LeftPanel.css")" rel="stylesheet" type="text/css" />*@
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/Keno/EnableStatus/Styles/Enablekeno.css")" rel="stylesheet" type="text/css" />
<div id="ng-app" data-ng-app="kenoStatusApp" data-ng-controller="KenoStatusController" style="display: none; width: 96%">
    <div id="errMsg" style="display: none" class="successMsg">
    </div>
    <table class="tableInfo" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td colspan="2" class="bold enableTitle"><div><div style="float: left"><input id="chkAll" type="checkbox" data-ng-click="CheckAll()" />&nbsp;All</div><div style="text-align: center">{{model.userName}}</div></div></td>
        </tr>
        <tr data-ng-repeat="item in betTypes" data-ng-hide="item.isHide" data-ng-init="item.disable = false; item.enable = !item.isDisabled; item.preVal = item.enable; item.disableDownline = true; item.enableDownline = !item.isDisabledDownlines; item.preValDownline = item.enableDownline">
            <td style="width: 50%">
                <input name="betTypes" type="checkbox" data-ng-change="item.disable = !item.enable; item.isDisabledDownlines = !item.enableDownline; CheckStatus({{item.preVal}}, this)" data-ng-model="item.enable" data-ng-disabled="item.isDisabledUpline" /><span>{{item.betTypeName}}</span>
            </td>
            <td>
                <input name="betTypes" data-ng-hide="@hide" type="checkbox" data-ng-change="item.disableDownlines = !item.enableDownline" data-ng-model="item.enableDownline" data-ng-disabled="item.disableDownline" /><span data-ng-hide="@hide">Enable Downlines</span>
            </td>
        </tr>
    </table>
    <div style="text-align: right" >
        <input class="buttonPopup" type="button" value="Submit" data-ng-click="Update()" style="margin-right: 0" />
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
@*<script src="@Url.Content("~/CustomerSetting/Keno/EnableStatus/GetKenoStatusData?id=" + ViewBag.id + "&uplineId=" + (ViewBag.roleId == 4 ? 0 : ViewBag.uplineId) + "&roleId=" + ViewBag.roleId)" type="text/javascript"></script>*@
<script type="text/javascript">
    var custId = parseInt('@ViewBag.id');
    var uplineId = parseInt('@ViewBag.uplineId');
    var roleId = parseInt('@ViewBag.roleId');

    function resolveClientUrl(url) {
        return '@Url.Content("~/")' + url;
    }
</script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/EnableStatus/Scripts/KenoStatusController.js")" type="text/javascript"></script>