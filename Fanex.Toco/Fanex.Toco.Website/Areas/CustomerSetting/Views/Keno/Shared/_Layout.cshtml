@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
<!DOCTYPE html>
<html ng-app='kenoSettingModule' id="ng-app">

<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Areas/CustomerSetting/Views/Keno/Styles/keno-setting.less"
        rel="stylesheet" type="text/css" />
    <link href="~/Areas/CustomerSetting/Views/Keno/Styles/Accounting/theme-color.less"
        rel="stylesheet" type="text/css" />
      <link href="~/Areas/CustomerSetting/Styles/jquery-ui.css" rel="stylesheet"
        type="text/css" />
    @{
        string positionTakingJsName = string.Empty;
        var KenoSetting = JsonConvert.SerializeObject(Model, Formatting.None, new JsonSerializerSettings
