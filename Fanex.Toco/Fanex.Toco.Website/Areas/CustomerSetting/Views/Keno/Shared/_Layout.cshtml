@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using Fanex.CustomerSetting.Module.Keno.Resources;
<!DOCTYPE html>
<html ng-app='kenoSettingModule' id="ng-app">

<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Areas/CustomerSetting/Views/Keno/Styles/keno-setting.less"
        rel="stylesheet" type="text/css" />
    <link href="~/Areas/CustomerSetting/Views/Keno/Styles/Accounting/theme-color.less"
        rel="stylesheet" type="text/css" />
      @*<link href="~/Areas/CustomerSetting/Styles/jquery-ui.css" rel="stylesheet"
        type="text/css" />*@
    <link href="~/Areas/CustomerSetting/Views/Keno/Styles/Accounting/JqueryUI/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />

            <link href="~/Areas/CustomerSetting/Views/Keno/Scripts/directives/dialog/ngDialog.css" rel="stylesheet"
        type="text/css" />
          <link href="~/Areas/CustomerSetting/Views/Keno/Scripts/directives/dialog/ngDialog-theme-default.css" rel="stylesheet"
        type="text/css" />
          <link href="~/Areas/CustomerSetting/Views/Keno/Scripts/directives/dialog/ngDialog-theme-plain.css" rel="stylesheet"
        type="text/css" />

          <link href="~/Areas/CustomerSetting/Views/Keno/Scripts/Tipsy/tipsy.css" rel="stylesheet"
        type="text/css" />
    @{
        string positionTakingJsName = string.Empty;
        var KenoSetting = JsonConvert.SerializeObject(Model, Formatting.None, new JsonSerializerSettings
        {
            ContractResolver = new CamelCasePropertyNamesContractResolver(),
            NullValueHandling = NullValueHandling.Ignore
        }); 
    }
</head>
<body>
<div ng-controller="mainController" class="content">
    <table cellspacing="0px" cellpadding="0px" border="0" class="maincontent_header">
        <tbody>
            <tr>
                <td class="maincontent_headerL">
                </td>
                <td class="maincontent_headerC fixfont">
                    @LayoutTexts.UpdateKenoSetting
                </td>
                <td class="maincontent_headerR">
                </td>
            </tr>
        </tbody>
    </table>
    <div id="divShowInfo" class="maincontent_box tableWidth">
    </div>
    <div id="customerInfo">
        @Html.Partial("~/Areas/CustomerSetting/Views/Keno/Setting/Partial/CustomerInfo/_Information.cshtml")
        @RenderBody()
    </div>
    <div class="btnLeft">
        <input ng-class-name="btnUpdate" check-disable-element ng-model="isUpdatedKeno" ng-click="updated(false)"  value="Update" 
            type="button" class="btnUpdate b" />
    </div>
</div>
</body>

<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>

<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/modules/module.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/repositories/repository.js")" type="text/javascript"></script>

<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/directives/CommonDirective.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/directives/BetSettingDirective.js")" type="text/javascript"></script>

<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/services/commonService.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/services/dataService.js")" type="text/javascript"></script>

<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/controllers/main.controller.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/controllers/customer-information.controller.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/controllers/bet-setting.controller.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/controllers/position-taking.controller.js")" type="text/javascript"></script>

<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/directives/dialog/ngDialog.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Keno/Scripts/Tipsy/jquery.tipsy.js")" type="text/javascript"></script>
<script type="text/javascript">
    var model = JSON.parse(Fanex.CustomerSetting.Core.DecodeHtml('@KenoSetting'));
    var domain = '@Url.Content("~")';
</script>
@RenderSection("scripts", required: false)
</html>
