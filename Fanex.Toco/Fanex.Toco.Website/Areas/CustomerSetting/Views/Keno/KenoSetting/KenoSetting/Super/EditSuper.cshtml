@*
namespace Fanex.CustomerSetting.Module.Keno.ViewModels
{
    using System;
    using System.Collections.Generic;
    using Fanex.CustomerSetting.Module.Keno.Entities;

    public class SuperSetting : CustomerSettingBase
    {
        public IList<SuperPositionTaking> SuperPositionTakings { get; set; }

        public SuperSetting()
        {
            this.BetSettings = new List<BetSetting>();
            for (int i = 1; i < 5; i++)
            {
                this.BetSettings.Add(new BetSetting{
                    BetTypeId = i,
                    SportTypeId = (i + 1) * 11,
                    BetTypeName = "Keno" + i,
                    MinBet = 1000,
                    MaxBet = 10000,
                    MaxPerMatch = 100000,
                    IsBetSettingUpdated = false,
                    IsEnabled = false,
                    IsDownlinesEnabled =false,
                    IsStatusUpdated = false
                });
            }

            this.SuperPositionTakings = new List<SuperPositionTaking>();
            for (int i = 1; i < 5; i++)
            {
                this.SuperPositionTakings.Add(new SuperPositionTaking
                {
                    BetTypeId = i,
                    SportTypeId = (i + 1) * 11,

                    S4 = 0.8,
                    M4 = 0.6,
                    A4 = 0.5,
                    N4 = 0.5,
                    L4 = 0.8,
                    SCO = 0.8,
                    SCOMax = 0.9,

                    IsUpdatePT = false,
                    IsUpdateS4 = false,
                    IsUpdateN4 = false,
                    IsUpdateSCO = false,
                });
            }
        }
    }
}*@
