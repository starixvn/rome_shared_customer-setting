@using Fanex.CustomerSetting.Module.Keno.Resources;
<table class="tableColor" ng-controller="fanex.customerSetting.customerInformationController">
    <tr>
        <td colspan="4" class="header c b">
            @if (Model.FormType == 0)
            {
                <span>@LayoutTexts.Super: </span>
            }
            else if (Model.FormType == 1)
            {
                <span>@LayoutTexts.Master: </span>
            }
            else if (Model.FormType == 2)
            {
                <span>@LayoutTexts.Agent: </span>
            }
            else
            {
                <span>@LayoutTexts.Member: </span>
            }
            <span ng-bind="model.username"></span>
        </td>
    </tr>
    <tr>
        <td class="col120 formatCol r b">
            @LayoutTexts.FirstName
        </td>
        <td class="col120 formatCol l">
            <span ng-bind="model.firstName"></span>
        </td>
        <td class="col120 formatCol r b">
            @LayoutTexts.LastName
        </td>
        <td class="col120 formatCol l">
            <span ng-bind="model.lastName"></span>
        </td>
    </tr>
    <tr>
        <td class="formatCol r b">
            @LayoutTexts.Phone
        </td>
        <td class="formatCol l">
            <span ng-bind="model.phone"></span>
        </td>
        <td class="formatCol r b">
            @LayoutTexts.MobilePhone
        </td>
        <td class="formatCol l">
            <span ng-bind="model.mobilePhone"></span>
        </td>
    </tr>
    <tr>
        <td class="formatCol r b">
            @LayoutTexts.Fax
        </td>
        <td class="formatCol l">
            <span ng-bind="model.fax"></span>
        </td>
        <td class="formatCol r b">
        </td>
        <td class="formatCol l">
        </td>
    </tr>
</table>
