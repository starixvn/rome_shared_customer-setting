@using Fanex.CustomerSetting.Module.Keno.Resources;

<table class="tableColor tableWidth" ng-controller="positionTakingController">
    <tr>
         <td colspan="6" class="header c b">
             <span>@LayoutTexts.PositionTaking</span>
           <input ng-class-name="btnSave" check-disable-element ng-model="$parent.isPositionTakingPartial"
                    ng-click="updated(true, 'PositionTaking')" type="button" />
        </td>
    </tr>
    <tr>
        <td class="col15percent formatCol c b header">
            @LayoutTexts.CountryMarket
        </td>
        <td class="col26percent formatCol c b header">
            @LayoutTexts.MasterPT
        </td>
        <td class="col9percent formatCol c b header" ng-hide="isDisableAutoMPT">
            @LayoutTexts.IsAuto
        </td>
        <td class="col25percent formatCol c b header">
            @LayoutTexts.AgentMaxPT
        </td>
        <td class="col25percent formatCol c b header">
            @LayoutTexts.AgentMinPT
        </td>
    </tr>
    <tr ng-repeat="positionTaking in positionTakingList track by $index" agent-position-taking-element ng-model="positionTaking" index="$index"  
        ng-class="{'betTypeInactive': $parent.isCopyAll && index != 0}">
    </tr>
</table>
