@using Fanex.CustomerSetting.Module.Keno.Resources;
@{
    ViewBag.Title = LayoutTexts.UpdateKenoSetting;
    Layout = "~/Areas/CustomerSetting/Views/Keno/Shared/_Layout.cshtml";
}
<div ng-controller="mainController" class="content">
    <table cellspacing="0px" cellpadding="0px" border="0" class="maincontent_header">
        <tbody>
            <tr>
                <td class="maincontent_headerL">
                </td>
                <td class="maincontent_headerC fixfont">
                    @LayoutTexts.UpdateKenoSetting
                </td>
                <td class="maincontent_headerR">
                </td>
            </tr>
        </tbody>
    </table>
    <div id="divShowInfo" class="maincontent_box col612">
    </div>
    <div id="customerInfo">
        @Html.Partial("~/Areas/CustomerSetting/Views/Keno/Setting/Partial/CustomerInfo/_Information.cshtml")
        <div style="margin-top: 10px;"></div>
        @Html.Partial("~/Areas/CustomerSetting/Views/Keno/Setting/Partial/BetSetting/_BetSettingSMA.cshtml")
        <div style="margin-top: 10px;"></div>
  @*      @Html.Partial("~/Areas/CustomerSetting/Views/Keno/Setting/Partial/PositionTaking/_SuperPositionTaking.cshtml")*@
    </div>
    <div class="btnLeft">
        <input ng-class-name="btnUpdate" ng-click="updateCustomerSetting(false)"
            type="button" value="Update" class="btnUpdate b" />
    </div>
</div>
