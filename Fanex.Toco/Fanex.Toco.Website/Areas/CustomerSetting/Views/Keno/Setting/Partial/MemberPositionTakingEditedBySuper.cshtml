@using Fanex.CustomerSetting.Module.Keno.Resources;
<table class="tableColor" ng-controller="fanex.customerSetting.positionTakingController">
    <tr>
        <td colspan="8" class="header c b">
            <span>@LayoutTexts.PositionTaking</span>
        </td>
    </tr>
    <tr>
        <td class="col120 formatCol c b">
            @LayoutTexts.CountryMarket
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.SuperPT
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.IsAuto
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.MasterPT
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.AgentPT
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.MasterComm
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.AgentComm
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.MemberComm
        </td>
    </tr>
    <tr ng-repeat="ptsection in model">
        <td class="col120 formatCol l">
            <span>{{ptsection.positionTaking.betTypeName}}</span>
        </td>
        <td class="col120 formatCol c">
            <select class="col60" ng-model="ptsection.positionTaking.value" ng-options="value for value in ptsection.positionTaking.rangeOfValue">
            </select>
        </td>
        <td class="col120 formatCol c">
            <label class="checkbox">
                <input type="checkbox" ng-model="ptsection.positionTaking.isAuto" />
            </label>
        </td>
        <td class="col120 formatCol c">
            <span>{{ptsection.positionTaking.downline.value}}</span>
        </td>
        <td class="col120 formatCol c">
            <span>{{ptsection.positionTaking.downline.downline.value}}</span>
        </td>
        <td class="col120 formatCol c">
            <span>{{ptsection.commissionSetting.upline.upline.value}}</span>
        </td>
        <td class="col120 formatCol c">
            <span>{{ptsection.commissionSetting.upline.value}}</span>
        </td>
        <td class="col120 formatCol c">
            <span>{{ptsection.commissionSetting.value}}</span>
        </td>
    </tr>
</table>