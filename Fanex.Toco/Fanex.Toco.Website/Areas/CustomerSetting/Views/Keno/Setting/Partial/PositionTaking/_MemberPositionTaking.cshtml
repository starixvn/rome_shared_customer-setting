@using Fanex.CustomerSetting.Module.Keno.Resources;
<table class="tableColor tableWidth" ng-controller="positionTakingController">
    <tr>
         <td colspan="6" class="header c b">
             <span>@LayoutTexts.PositionTaking</span>
           <input ng-class-name="btnSave" check-disable-element ng-model="isPositionTakingPartial"
                    ng-click="updated(true, 'PositionTaking')" type="button" />
        </td>
    </tr>
    <tr>
        <td class="col15percent formatCol c b">
            @LayoutTexts.CountryMarket
        </td>
        <td class="col42percent formatCol c b">
            @LayoutTexts.AgentPT
        </td>
        <td class="col43percent formatCol c b">
            @LayoutTexts.MemberComm
        </td>
    </tr>
      <tr ng-repeat="positionTaking in positionTakingList" member-position-taking-element ng-model="positionTaking" index="$index">
    </tr>
</table>