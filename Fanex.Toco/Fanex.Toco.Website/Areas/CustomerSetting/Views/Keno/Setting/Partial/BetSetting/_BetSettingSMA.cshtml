                <span ng-show="betSetting.upline.maxPerMatch >= 0">&lt;= {{betSetting.upline.maxPerMatch
                    | number : 0}} </span>
            </td>
            <td class="col60 formatCol c">
                <label class="checkbox">
                    <input type="checkbox" ng-model="betSetting.isDisable" />
                </label>
            </td>
