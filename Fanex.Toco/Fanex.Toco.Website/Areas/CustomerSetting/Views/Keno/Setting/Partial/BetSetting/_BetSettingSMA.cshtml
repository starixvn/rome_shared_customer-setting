@using Fanex.CustomerSetting.Module.Keno.Resources;
<table class="tableColor tableWidth" ng-controller="betSettingController">
    <thead>
        <tr>
            <td rowspan="2" class="header col15percent">
            </td>
            <td colspan="3" class="header c b">
                <span>@LayoutTexts.BetSetting</span>
            </td>
            <td colspan="2" class="header c b">
                <span>@LayoutTexts.EnableStatus</span>
                <input ng-class-name="btnSave" check-disable-element ng-model="isBetSettingPartial"
                    ng-click="updated(true, 'BetSetting')" type="button" />
            </td>
        </tr>
        <tr>
            <td class="formatCol c b header col23percent">
                <span>@LayoutTexts.MinBet</span>
            </td>
            <td class="formatCol c b header col23percent">
                <span>@LayoutTexts.MaxBet</span>
            </td>
            <td class="formatCol c b header col23percent">
                <span>@LayoutTexts.MaxPerMatch</span>
            </td>
            <td class=" formatCol c b header " ng-switch="roleId">
                <span class="col8percent" ng-switch-when="4">@LayoutTexts.Super </span>
                <span class="col8percent" ng-switch-when="3">@LayoutTexts.Master </span>
                <span class="col8percent" ng-switch-when="2">@LayoutTexts.Agent </span>
                <span class="col17percent" ng-switch-default>@LayoutTexts.Member</span>
            </td>
            <td ng-if="roleId != 1" class=" formatCol c b header col8percent">
                <span>@LayoutTexts.Downlines</span>
            </td>
        </tr>
    </thead>
    <tbody>
        <tr ng-repeat="betSetting in betSettingList track by $index" bet-setting-element
            ng-model="betSetting" index="$index" ng-class="{'betTypeInactive': $parent.isCopyAll && index != 0}">
        </tr>
    </tbody>
</table>
