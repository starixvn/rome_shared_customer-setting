@using Fanex.CustomerSetting.Module.Keno.Resources;
<table class="tableColor" ng-controller="betSettingController">
    <thead>
        <tr>
            <td rowspan="2" class="header">
            </td>
            <td colspan="3" class="header c b">
                <span>@LayoutTexts.BetSetting</span>
            </td>
            <td colspan="2" class="header c b">
                <span>@LayoutTexts.EnableStatus</span>
                <input ng-class-name="btnSave" check-disable-element ng-model="isBetSettingPartial"
                    ng-click="updated(true, 'BetSetting')" type="button" />
            </td>
        </tr>
        <tr>
            <td class="formatCol c b header">
                <span>@LayoutTexts.MinBet</span>
            </td>
            <td class="formatCol c b header">
                <span>@LayoutTexts.MaxBet</span>
            </td>
            <td class="formatCol c b header">
                <span>@LayoutTexts.MaxPerMatch</span>
            </td>
            <td class=" formatCol c b header">
                <span>@LayoutTexts.Super</span> 
            </td>
            <td class=" formatCol c b header">
                <span>@LayoutTexts.Downlines</span>
            </td>
        </tr>
    </thead>
    <tbody>
        <tr ng-repeat="betSetting in betSettingList" bet-setting-element ng-model="betSetting" index="$index" ng-controller="betSettingRowController">
           @* <td bet-setting-element></td>*@
        @* <td   bet-setting-element betSetting="betSetting"></td>*@
        </tr>
        @*<tr ng-repeat="betSetting in betSettingList">
            <td class="col120 formatCol l">
                <span>{{betSetting.betTypeName}}</span>
                <div style="display: inline-block; float: right;" ng-switch="($index)==0">
                    <input ng-switch-when="true" ng-class-name="btnCopyAll" check-disable-element ng-model="isBetSettingPartial"
                        ng-click="updated(true, 'BetSetting')" type="button" /></div>
            </td>
            <td class="col150 formatCol l">
                <input type="text" class="input" ng-model="betSetting.minBet" ng-change="betSetting.actions.changeMinBet()"
                    style="width: 50px;" />
                <span ng-show="betSetting.upline.minBet >= 0">&gt;= {{betSetting.upline.minBet | number
                    : 0}} </span>
            </td>
            <td class="col150 formatCol l">
                <input type="text" class="input" ng-model="betSetting.maxBet" ng-change="betSetting.actions.changeMaxBet()"
                    style="width: 50px;" />
                <span ng-show="betSetting.upline.maxBet >= 0">&lt;= {{betSetting.upline.maxBet | number
                    : 0}} </span>
            </td>
            <td class="col150 formatCol l">
                <input type="text" class="input" ng-model="betSetting.maxPerMatch" ng-change="betSetting.actions.changeMaxPerMatch()"
