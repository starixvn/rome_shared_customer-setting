@using Fanex.CustomerSetting.Module.Keno.Resources;
<table class="tableColor" ng-controller="fanex.customerSetting.positionTakingController">
    <tr>
        <td colspan="4" class="header c b">
            <span>@LayoutTexts.PositionTaking</span>
            <input type="button" ng-click="updateCustomerSetting(true, 'PositionTaking')" value="Save"
                class="icon-setting-copy" title="Save position taking" />
        </td>
    </tr>
    <tr>
        <td class="col120 formatCol c b">
            @LayoutTexts.CountryMarket
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.SuperMaxPT
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.SuperMinPT
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.SuperCommission
        </td>
    </tr>
    <tr ng-repeat="ptsection in model">
        <td class="col120 formatCol l">
            <span>{{ptsection.positionTaking.betTypeName}}</span>
            <input type="button" ng-click="ptsection.positionTaking.actions.copyToAll(model);ptsection.commissionSetting.actions.copyToAll(model)" value="Copy" class="icon-setting-copy"
                ng-if="$index == 0" title="Copy this setting to all" />
        </td>
        <td class="col120 formatCol c">
            <select class="col60" ng-model="ptsection.positionTaking.max" ng-change="ptsection.positionTaking.actions.changeMax()" ng-options="value for value in ptsection.positionTaking.rangeOfMax">
            </select>
        </td>
        <td class="col120 formatCol c">
            <select class="col60" ng-model="ptsection.positionTaking.min" ng-options="value for value in ptsection.positionTaking.rangeOfMin">
            </select>
        </td>
        <td class="col120 formatCol c">
            <select class="col60" ng-model="ptsection.commissionSetting.value" ng-options="value for value in ptsection.commissionSetting.range">
            </select>
        </td>
    </tr>
</table>
