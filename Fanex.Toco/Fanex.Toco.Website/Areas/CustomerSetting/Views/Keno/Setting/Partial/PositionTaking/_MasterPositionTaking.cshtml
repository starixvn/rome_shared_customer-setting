@using Fanex.CustomerSetting.Module.Keno.Resources;
<table class="tableColor tableWidth" ng-controller="positionTakingController">
    <tr>
        <td colspan="6" class="header c b">
            <span>@LayoutTexts.PositionTaking</span>
            <input ng-class-name="btnSave" check-disable-element ng-model="isPositionTakingPartial"
                ng-click="updated(true, 'PositionTaking')" type="button" />
        </td>
    </tr>
    <tr>
        <td class="col15percent formatCol c b">
            @LayoutTexts.CountryMarket
        </td>
        <td class="col19percent formatCol c b">
            @LayoutTexts.SuperPT
        </td>
        <td class="col9percent formatCol c b">
            @LayoutTexts.IsAuto
        </td>
        <td class="col19percent formatCol c b">
            @LayoutTexts.MasterMaxPT
        </td>
        <td class="col19percent formatCol c b">
            @LayoutTexts.MasterMinPT
        </td>
        <td class="col19percent formatCol c b">
            @LayoutTexts.MasterComm
        </td>
    </tr>
    <tr ng-repeat="positionTaking in positionTakingList" master-position-taking-element
        ng-model="positionTaking" index="$index">
    </tr>
    <tr style="display: none;">
        <td>
            <div id="dialogMemberPT" style="display: none;">
                <div>
                    You have changed this Master not to take auto position taking.</div>
                <div>
                    Do you want to update all member's position taking to:</div>
                <div ng-repeat="positionTaking in positionTakingList" ng-model="positionTaking" confirm-is-auto>
                </div>
            </div>
        </td>
    </tr>
    <script type="text/ng-template"  id="popupId">
        <div class="ngdialog-message">
            <h3>
                ngDialog template</h3>
            <p ng-show="theme">
                Test content for <code>{{theme}}</code></p>
            <p ng-show="ngDialogData.foo">
                Data passed through directive: <code>{{ngDialogData.foo}}</code></p>
        </div>
        <div ng-repeat="positionTaking in  positionTakingList" ng-model="positionTaking">
            <div ng-if="positionTaking.isConfirmIsAuto" style="margin-top: 5px; padding-left: 50px;">
                <span ng-bind="positionTaking.betTypeName" style="margin-right: 10px;"></span>
                <select class="col60" ng-model="positionTaking.newMemberPT" ng-options="value for value in memberNewValueRange">
                </select>
            </div>
        </div>
        <div class="ngdialog-buttons">
            <button type="button" class="ngdialog-button ngdialog-button-secondary" ng-dialog-class="ngdialog-theme-default"
                ng-click="setValueAllMember(false);" ng-dialog-close-previous>
                NO</button>
            <button type="button" class="ngdialog-button ngdialog-button-primary" ng-click="setValueAllMember(true);">
                YES</button>
        </div>
    </script>
</table>
