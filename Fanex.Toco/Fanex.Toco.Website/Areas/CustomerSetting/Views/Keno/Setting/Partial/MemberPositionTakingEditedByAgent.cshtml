@using Fanex.CustomerSetting.Module.Keno.Resources;
<table class="tableColor" ng-controller="fanex.customerSetting.positionTakingController">
    <tr>
        <td colspan="3" class="header c b">
            <span>@LayoutTexts.PositionTaking</span>
        </td>
    </tr>
    <tr>
        <td class="col120 formatCol c b">
            @LayoutTexts.CountryMarket
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.AgentPT
        </td>
        <td class="col120 formatCol c b">
            @LayoutTexts.MemberComm
        </td>
    </tr>
    <tr ng-repeat="ptsection in model">
        <td class="col120 formatCol l">
            <span>{{ptsection.positionTaking.betTypeName}}</span>
        </td>
        <td class="col120 formatCol c">
            <select class="col60" ng-model="ptsection.positionTaking.value" ng-options="value for value in ptsection.positionTaking.rangeOfValue">
            </select>
        </td>
        <td class="col120 formatCol c">
            <select class="col60" ng-model="ptsection.commissionSetting.value" ng-options="value for value in ptsection.commissionSetting.range">
            </select>
        </td>
    </tr>
</table>