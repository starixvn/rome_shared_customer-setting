@using Fanex.CustomerSetting.Module.Keno.Resources;
<table class="tableColor tableWidth" ng-controller="positionTakingController">
    <tr>
        <td colspan="4" class="header c b">
            <span>@LayoutTexts.PositionTaking</span>
           <input ng-class-name="btnSave" check-disable-element ng-model="isPositionTakingPartial"
                    ng-click="updated(true, 'PositionTaking')" type="button" />
        </td>
    </tr>
    <tr>
        <td class="col120 formatCol c b col15percent">
            @LayoutTexts.CountryMarket
        </td>
        <td class="col120 formatCol c b col28percent">
            @LayoutTexts.SuperMaxPT
        </td>
        <td class="col120 formatCol c b col28percent">
            @LayoutTexts.SuperMinPT
        </td>
        <td class="col120 formatCol c b col29percent">
            @LayoutTexts.SuperCommission
        </td>
    </tr>
    <tr ng-repeat="positionTaking in positionTakingList" super-position-taking-element ng-model="positionTaking" index="$index">
    </tr>
</table>
