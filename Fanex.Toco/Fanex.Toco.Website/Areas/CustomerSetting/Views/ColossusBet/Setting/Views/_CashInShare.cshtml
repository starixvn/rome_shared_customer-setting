@using Fanex.CustomerSetting.Module.ColossusBetSetting.Resources;
@model Fanex.CustomerSetting.Module.ColossusBetSetting.Entities.ColossusBetModel
@{
    var cashInShareLabel = string.Empty;
    switch((int)Model.CustomerInformationPartial.RoleId)
    {
        case 4: 
            cashInShareLabel = Messages.SuperCashInShare;
            break;
        case 3: 
            cashInShareLabel = Messages.MasterCashInShare;
            break;
        case 2: 
            cashInShareLabel = Messages.AgentCashInShare;
            break;
        default: 
            cashInShareLabel = Messages.MemberCashInShare;
            break;
    }                            
}
<table class="tableColor tableWidth" ng-controller="cashInShareController">
    <tr>
        <td colspan="4" class="header c b">
            <span>@Messages.CashInShare</span>
            <input ng-if="customerInformationPartial.RoleId >1" ng-class-name="btnSave" check-disable-element ng-model="cashInSharePartial.IsCashInShareUpdated"
                ng-click="updated(true, 'CashInSharePartial')" type="button" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="formatCol l betSetting" style="height: 34px;">
            <div class="b" style="padding-left: 30px; width: 150px; display: inline-block;">
              <span>@cashInShareLabel</span>
            </div>
              <div style="display: inline-block; padding-left: 30px;">
            @if (Model.CustomerInformationPartial.RoleId > 1)
            {
                <input input-format  id="cashInShareInputId" ng-model="cashInSharePartial.CashInShareValue" class="r" type="text" title="" style="text-align: right; padding-right: 5px; width:100px;" />
                <span> <= <label ng-bind="cashInSharePartial.MaxCashInShareValue"></label> </span>
            }
            else
            {
                 <input disabled ng-model="cashInSharePartial.MaxCashInShareValue" class="r" type="text"  style="text-align: right; padding-right: 5px; width:100px;" />
            }
            </div>
        </td>
    </tr>
</table>
