@using Fanex.CustomerSetting.Module.ColossusBetSetting.Resources;
@model Fanex.CustomerSetting.Module.ColossusBetSetting.Entities.ColossusBetModel
@{
    var commissionLabel = string.Empty;
    switch ((int)Model.CustomerInformationPartial.RoleId)
    {
        case 4:
            commissionLabel = Messages.SuperCommision;
            break;
        case 3:
            commissionLabel = Messages.MasterCommision;
            break;
        case 2:
            commissionLabel = Messages.AgentCommision;
            break;
        default:
            commissionLabel = Messages.MemberCommision;
            break;
    }                            
}
<table class="tableColor tableWidth" ng-controller="commissionController">
    <tr>
        <td colspan="4" class="header c b">
            <span>@Messages.Commission</span>
            <input ng-if="customerInformationPartial.RoleId >1" ng-class-name="btnSave" check-disable-element ng-model="comissionPartial.IsCommisionUpdated"
                ng-click="updated(true, 'ComissionPartial')" type="button" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="formatCol l betSetting" style="height: 34px;">
            <div class="b" style="padding-left: 30px; width: 150px; display: inline-block;">
                    <span>@commissionLabel</span>
            </div>
              <div style="display: inline-block; padding-left: 30px;">
            @if (Model.CustomerInformationPartial.RoleId > 1)
            {
               <input input-format pattern="[0-9]+([\.,][0-9]+)*" id="commissionInputId" ng-model="comissionPartial.CommisionValue"class="r" type="text" title="" style="text-align: right; padding-right: 5px; width:100px;" />
                 <span>  <= <label ng-bind="comissionPartial.MaxCommisionValue"></label> </span>  
            }
            else
            {
                <input disabled ng-model="comissionPartial.CommisionValue"   class="r" type="text"  style="text-align: right; padding-right: 5px; width:100px;" />
            }
            </div>
        </td>
    </tr>
</table>
