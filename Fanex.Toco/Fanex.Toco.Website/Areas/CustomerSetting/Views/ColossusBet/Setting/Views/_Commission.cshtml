@using Fanex.CustomerSetting.Module.ColossusBetSetting.Resources;
@model Fanex.CustomerSetting.Module.ColossusBetSetting.Entities.ColossusBetModel
@{
    var commissionLabel = string.Empty;
    switch ((int)Model.CustomerInformationPartial.RoleId)
    {
        case 4:
            commissionLabel = Messages.SuperCommision;
            break;
        case 3:
            commissionLabel = Messages.MasterCommision;
            break;
        default:
            commissionLabel = Messages.AgentCommision;
            break;
    }                            
}
<table class="tableColor tableWidth" ng-controller="commissionController">
    <tr>
        <td colspan="4" class="header c b">
            <span>@Messages.Commission</span>
            @if (Model.CustomerInformationPartial.RoleId > 1)
            {
            <input ng-class-name="btnSave" check-disable-element ng-model="comissionPartial.IsCommisionUpdated"
                ng-click="updated(true, 'ComissionPartial')" type="button" />
            }
        </td>
    </tr>
    <tr>
        <td colspan="4" class="formatCol l betSetting height34">
            <div class="b divInline col150 padding-left30">
                    <span>@commissionLabel</span>
            </div>
              <div class="divInline padding-left30">
            @if (Model.CustomerInformationPartial.RoleId > 1)
            {
                 <input input-format pattern="[0-9]+([\.,][0-9]+)*" id="commissionInputId" ng-model="comissionPartial.CommisionValue" class="r col100" type="text" />
                 <span>  <=  @Model.ComissionPartial.MaxCommisionValue </span>  
            }
            else
            {
                <input disabled value="@Model.ComissionPartial.CommisionValue"  type="text"   class="r col100" />
            }
            </div>
        </td>
    </tr>
</table>
