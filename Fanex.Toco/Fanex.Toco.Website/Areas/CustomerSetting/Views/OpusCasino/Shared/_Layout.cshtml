@using Fanex.CustomerSetting.OpusCasino.ViewModels;
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
<!DOCTYPE html>
<html  ng-app='OpusCasino' id="ng-app">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Areas/CustomerSetting/Views/OpusCasino/Styles/OpusCasinoSetting.less"
        rel="stylesheet" type="text/css" />
    <link href="~/Areas/CustomerSetting/Views/OpusCasino/Styles/Agent/ThemeColor.less"
        rel="stylesheet" type="text/css" />
    @{
        string positionTakingJsName = string.Empty;
        int roleID = Model.CustomerInformation.RoleID;
        var OpusSetting = JsonConvert.SerializeObject(Model, Formatting.None, new JsonSerializerSettings
        {
            ContractResolver = new CamelCasePropertyNamesContractResolver(),
            NullValueHandling = NullValueHandling.Ignore
        }); 
   
    }
</head>
<body>
    <div ng-controller="opusSettingController" class="content">
        <div id="customerInfo">
            <table class="tableColor"  ng-controller="customerInfoController">
                <tr>
                    <td colspan="4" class="header c b">
                        CustomerInfo
                    </td>
                </tr>
                <tr>
                    <td class="col120 formatCol r b">
                        Username
                    </td>
                    <td class="col120 formatCol l">
                        {{customerInfo.username }}
                    </td>
                    <td class="col120 formatCol r b">
                        Nick Name
                    </td>
                    <td class="col243 formatCol l">
                        {{customerInfo.nickName }}
                    </td>
                </tr>
                <tr>
                    <td class="formatCol r b">
                        First Name
                    </td>
                    <td class="formatCol l">
                        {{customerInfo.firstName }}
                    </td>
                    <td class="formatCol r b">
                        Last Name
                    </td>
                    <td class="col243 formatCol l">
                        {{customerInfo.lastName }}
                    </td>
                </tr>
                <tr>
                    <td class="formatCol r b">
                        Phone
                    </td>
                    <td class="formatCol l">
                        {{customerInfo.phone }}
                    </td>
                    <td class="formatCol r b">
                        Mobile Phone
                    </td>
                    <td class="formatCol l">
                        {{customerInfo.mobilePhone }}
                    </td>
                </tr>
                <tr>
                    <td class="formatCol r b">
                        Fax
                    </td>
                    <td class="formatCol l">
                        {{customerInfo.fax }}
                    </td>
                    <td class="formatCol r b">
                        Enable
                    </td>
                    <td class="col243 formatCol l" ng-init="getRoleName()">
                        <input type="checkbox" ng-model="customerInfo.isEnable" ng-change="checkDownlineButton()"/>
                        {{roleName}}
                        <input type="checkbox" ng-disabled="isDownlineDisabled" ng-model="customerInfo.isDownline" ng-init="checkDownlineButton()"/>Downlines
                    </td>
                </tr>
            </table>
            @RenderBody()
        </div>
        <div class="btnLeft">
        <input ng-class-name="btnUpdate" check-disable-element ng-model="isDisabledUpdated" ng-click="" type="button" value="Update" class="btnUpdate b"/>
        </div>
    </div>
</body>
<script type="text/javascript">

</script>
@RenderSection("scripts", required: false)
<script src="~/Areas/CustomerSetting/Scripts/jquery.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Views/OpusCasino/Scripts/Libs/head.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Scripts/angular.min.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Scripts/Validators.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Views/OpusCasino/Scripts/Setting/OpusSettingAgular.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Views/OpusCasino/Scripts/Setting/CustomerInfoController.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Views/OpusCasino/Scripts/Setting/BetSettingController.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Views/OpusCasino/Scripts/Setting/SMA_Level/SMAGameSettingController.js" type="text/javascript"></script>
@switch (roleID)
{
    case 4:
        positionTakingJsName = "SuperPositionTakingController.js";
        break;
    case 3:
        positionTakingJsName = "MasterPositionTakingController.js";
        break;
}
<script src="~/Areas/CustomerSetting/Views/OpusCasino/Scripts/Setting/SMA_Level/SuperPositionTakingController.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Views/OpusCasino/Scripts/Setting/SMA_Level/MasterPositionTakingController.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Views/OpusCasino/Scripts/Setting/SMA_Level/AgentPositionTakingController.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Views/OpusCasino/Scripts/Setting/Member_Level/MemberPositionTakingController.js" type="text/javascript"></script>
<script src="~/Areas/CustomerSetting/Views/OpusCasino/Scripts/Setting/Member_Level/MemberGameSettingController.js" type="text/javascript"></script>
@*@Scripts.Render("~/bundles/racingsetting/super")*@
<script type="text/javascript">
    var model = JSON.parse(Fanex.CustomerSetting.Core.DecodeHtml('@OpusSetting'));
</script>
</html>
