@model dynamic

@{
    ViewBag.Title = "Member Opus Setting";
    Layout = "~/Areas/CustomerSetting/Views/OpusCasino/Shared/_Layout.cshtml";
}
<table ng-controller="memberPositionTakingController"  >
<tr>
    <td colspan="2" class="header l b">
        <span class="textHeader">Postion Talking/Commission</span>
        <input ng-class-name="btnSave" check-disable-element ng-model="isDisabledSavedPT"
                ng-click="" type="button" />
</tr>
<tr>
    <td  class="col243 formatCol c b">Agent Preset PT</td>
    <td  class="col366 formatCol c b">Member Commission</td>
</tr> 
<tr>
    <td  class="formatCol c b">
        <select></select>
    </td>
    <td class="formatCol c b">
        <select></select>
    </td>
</tr> 
</table>  
<table ng-controller="betSettingController">
    <tr>
        <td class="col612 header l b ">
            <span class="textHeader">Bet Setting</span>
            <input ng-class-name="btnSave" check-disable-element ng-model="isDisabledSaveBetSetting"
                ng-click="" type="button" />
        </td>
    </tr>
    <tr>
        <td>
            <span class="base-font b">Member Max Transfer Credit</span>
            <input onkeydown='validateNumber(event)' type="text" ng-model="betLimitSetting.maxTransfer" />
            <label class="base-font">
                <input class="chb" type="checkbox" ng-model="betLimitSetting.isDailyAutoResetLimit" />
                Daily auto reset limit (at 12 noon GMT+8)
            </label>
            <br />
            <span id="numberLimit" class="base-font">(1 - {{betLimitSetting.maxTransferAllowed}})</span>
        </td>
    </tr>
</table>
<table ng-controller="memberGameSettingController">
    <tr>
        <td colspan="2" class="header l b">
            <span class="textHeader">Game Setting</span>
            <input ng-class-name="btnSave" check-disable-element ng-model="isDisabledSaveGameSetting"
                ng-click="" type="button" />
        </td>
    </tr>
    <tr>
        <td class="col120 formatCol r b">
            Game Type
        </td>
        <td class="col489 formatCol l b">
            Betting Limit
        </td>
    </tr>
    <tr ng-repeat="gameSetting in gameSettingList">
        <td class="formatCol r">
            {{gameSetting.gameTypeName}}
        </td>
        <td class="formatCol">
            <label ng-repeat="bettingLimit in gameSetting.bettingLimitList">
                <input type="radio" ng-model="gameSetting.stakeChoosen.iD" value="{{bettingLimit.iD}}" ng-click="changeStatusCheckbox()" />
                {{bettingLimit.value}}
            </label>
        </td>
    </tr>
</table>
@section scripts
{
    @*@Scripts.Render("~/bundles/racingsetting/super")*@
