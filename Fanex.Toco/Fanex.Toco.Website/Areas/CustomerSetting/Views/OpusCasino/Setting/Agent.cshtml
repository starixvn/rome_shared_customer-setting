@model dynamic
@{
    ViewBag.Title = "Agent Opus Setting";
    Layout = "~/Areas/CustomerSetting/Views/OpusCasino/Shared/_Layout.cshtml";
}
  <table class="tableColor"  ng-controller="customerInfoController">
                <tr>
                    <td colspan="4" class="header c b">
                        CustomerInfo
                    </td>
                </tr>
                <tr>
                    <td class="col120 formatCol r b">
                        Username
                    </td>
                    <td class="col120 formatCol l">
                        {{customerInfo.username }}
                    </td>
                    <td class="col120 formatCol r b">
                        Nick Name
                    </td>
                    <td class="col243 formatCol l">
                        {{customerInfo.nickName }}
                    </td>
                </tr>
                <tr>
                    <td class="formatCol r b">
                        First Name
                    </td>
                    <td class="formatCol l">
                        {{customerInfo.firstName }}
                    </td>
                    <td class="formatCol r b">
                        Last Name
                    </td>
                    <td class="col243 formatCol l">
                        {{customerInfo.lastName }}
                    </td>
                </tr>
                <tr>
                    <td class="formatCol r b">
                        Phone
                    </td>
                    <td class="formatCol l">
                        {{customerInfo.phone }}
                    </td>
                    <td class="formatCol r b">
                        Mobile Phone
                    </td>
                    <td class="formatCol l">
                        {{customerInfo.mobilePhone }}
                    </td>
                </tr>
                <tr>
                    <td class="formatCol r b">
                        Fax
                    </td>
                    <td class="formatCol l">
                        {{customerInfo.fax }}
                    </td>
                    <td class="formatCol r b">
                        Enable
                    </td>
                    <td class="col243 formatCol l" ng-init="getRoleName()">
                        <input type="checkbox" ng-model="customerInfo.isEnable" ng-change="checkDownlineButton()"/>
                        Agent
                        <input type="checkbox" ng-disabled="isDownlineDisabled" ng-model="customerInfo.isDownline" ng-init="checkDownlineButton()"/>Downlines
                    </td>
                </tr>
            </table>
<table ng-controller="agentPositionTakingController">
    <tr>
        <td colspan="5" class="header l b">
            <span class="textHeader">Postion Talking/Commission</span>
            <input ng-class-name="btnSave" check-disable-element ng-model="isDisabledSavedPT"
                ng-click="" type="button" />
        </td>
    </tr>
    <tr>
        <td class="col120 formatCol c b">
            Master Preset PT
        </td>
        <td class="col120 formatCol c b">
            Master Auto Preset PT
        </td>
        <td class="col120 formatCol c b">
            Agent Max PT
        </td>
        <td class="col120 formatCol c b">
            Agent Min PT
        </td>
        <td class="col120 formatCol c b">
            Agent Comm
        </td>
    </tr>
    <tr>
        <td class="col120 formatCol c b">
            <select ng-disabled="positionTaking.iM2" class="col60" ng-model="positionTaking.m2"
                ng-options="value for value in m2Range">
            </select>
        </td>
        <td class="col120 formatCol c b">
            <input class="chb" type="checkbox" ng-model="positionTaking.iM2" />
            <select ng-disabled="!positionTaking.iM2" class="col60" ng-model="positionTaking.uM2"
                ng-options="value for value in uM2Range">
            </select>
        </td>
        <td class="col120 formatCol c b">
            <select class="col60" ng-model="positionTaking.l2" ng-options="value for value in maxPTRange">
            </select>
        </td>
        <td class="col120 formatCol c b">
            <select class="col60" ng-model="positionTaking.n2" ng-options="value for value in minPTRange">
            </select>
        </td>
        <td class="col120 formatCol c b">
            <select class="col60" ng-model="positionTaking.comm2" ng-options="value for value in commRange">
            </select>
        </td>
    </tr>
</table>
<table ng-controller="betSettingController">
    <tr>
        <td class="col612 header l b ">
            <span class="textHeader">Bet Setting</span>
            <input ng-class-name="btnSave" check-disable-element ng-model="isDisabledSaveBetSetting"
                ng-click="" type="button" />
        </td>
    </tr>
    <tr>
        <td>
            <span class="base-font b">Member Max Transfer Credit</span>
            <input onkeydown='validateNumber(event)' type="text" ng-model="betLimitSetting.maxTransfer" />
            <label class="base-font">
                <input class="chb" type="checkbox" ng-model="betLimitSetting.isDailyAutoResetLimit" />
                Daily auto reset limit (at 12 noon GMT+8)
            </label>
            <br />
            <span id="numberLimit" class="base-font">(1 - {{betLimitSetting.maxTransferAllowed}})</span>
        </td>
    </tr>
</table>
<table ng-controller="sMAGameSettingController">
    <tr>
        <td colspan="2" class="header l b">
            <span class="textHeader">Game Setting</span>
            <input ng-class-name="btnSave" check-disable-element ng-model="isDisabledSaveGameSetting"
                ng-click="" type="button" />
        </td>
    </tr>
    <tr>
        <td class="col120 formatCol r b">
            Game Type
        </td>
        <td class="col489 formatCol l b">
            Betting Limit
        </td>
    </tr>
    <tr ng-repeat="gameSetting in gameSettingList">
        <td class="formatCol r">
            {{gameSetting.gameTypeName}}
        </td>
        <td class="formatCol">
            <label ng-repeat="bettingLimit in gameSetting.bettingLimitList">
                <input type="checkbox" ng-model="bettingLimit.isChecked" ng-click="changeStatusCheckbox()" />
                {{bettingLimit.value}}
            </label>
        </td>
    </tr>
</table>
@section scripts
{
    @*@Scripts.Render("~/bundles/racingsetting/super")*@
    <script type="text/javascript">
        /* window.pageRole = ptRacingCommon.masterRoleId;
        window.targetRoleId = ptRacingCommon.agentRoleId;*/
            
    </script>
}
