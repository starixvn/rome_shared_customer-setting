<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="enablestatus">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="products">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="product" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>                  
                  <xs:sequence>
                    <xs:element name="sps">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="sp" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="params">
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="param" minOccurs="0" maxOccurs="unbounded">
                                        <xs:complexType>
                                          <xs:attribute name="type" type="xs:string" use="required" />
                                          <xs:attribute name="name" type="xs:string" use="required" />
                                          <xs:attribute name="value" type="xs:string" use="required" />                                          
                                        </xs:complexType>
                                      </xs:element>
                                    </xs:sequence>                                    
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                              <xs:attribute name="key" type="xs:string" use="required" />
                              <xs:attribute name="type" type="xs:string" use="required" />
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>                        
                      </xs:complexType>
                    </xs:element>                    
                  </xs:sequence>
                  <xs:attribute name="id" type="xs:string" use="required" />
                  <xs:attribute name="title" type="xs:string" use="required" />
                  <xs:attribute name="hasgroup" type="xs:boolean" use="required" />
                  <xs:attribute name="hascheckall" type="xs:boolean" use="required" />
                  <xs:attribute name="width" type="xs:string" use="required" />
                  <xs:attribute name="height" type="xs:string" use="required" />
                  <xs:attribute name="showinframe" type="xs:boolean" use="required" />
                </xs:complexType>                
              </xs:element>              
            </xs:sequence>
            <xs:attribute name="iframeid" type="xs:string" use="required" />
          </xs:complexType>          
        </xs:element>        
      </xs:sequence>      
    </xs:complexType>    
  </xs:element>
  <xs:complexType name="SpTypes" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="SELECT" type="xs:string" />
      <xs:element name="UPDATE" type="xs:string" />
      <xs:element name="INSERT" type="xs:string" />
      <xs:element name="DELETE" type="xs:string" />
      <xs:element name="TEXT" type="xs:string" />
    </xs:choice>
  </xs:complexType>
</xs:schema>