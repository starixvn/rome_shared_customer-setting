    <product id="casino" reloadafterupdate="true" function="EnableCasino" >
      <sps>
        <sp key="" type="SELECT">
          <params />
          <results />
        </sp>
        <sp key="Acc_UpdCSStatus" type="UPDATE">
          <params>
            <param name="custid" mapproperty="CustId" />
            <param name="disabledcs" mapproperty="Disabled" />
            <param name="synccs" mapproperty="Synced" />
            <param name="enabledownline" mapproperty="DisabledDownlines" reverse="true" />
            <param name="subaccid" mapproperty="SubAccId" />
            <param name="userid" mapproperty="UserId" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
