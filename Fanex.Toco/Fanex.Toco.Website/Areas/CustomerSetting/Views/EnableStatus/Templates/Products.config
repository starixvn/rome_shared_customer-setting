<?xml version="1.0" encoding="utf-8" ?>
<enablestatus>
<!--<enablestatus xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="Template.xsd">-->
  <products iframeid="leftFrame">
    <product id="keno" hascheckall="true" reloadafterupdate="true" hidebettypes="1502" warning="warningKenoBeijing">
      <sps>
        <sp key="Acc_CustomerSelKenoStatus" type="SELECT">
          <params>
            <param name="custid" mapproperty="CustId" />
            <param name="roleid" mapproperty="Level" />
            <param name="uplineid" mapproperty="UplineId" />
            <param name="hasdownline" mapproperty="HasDownline" />
          </params>
          <results>
            <column name="username" mapproperty="Username" />
            <column name="ibcbettypeid" mapproperty="BetTypeId" />
            <column name="isdisabled" mapproperty="Disabled" />
            <column name="disableUplines" mapproperty="DisabledUplines" />
            <column name="disableDownlines" mapproperty="DisabledDownlines" />
          </results>
        </sp>
        <sp key="Acc_CustomerUpdDisableKeno" type="UPDATE">
          <params>
            <param name="custid" mapproperty="CustId" />
            <param name="bettype" mapproperty="BetTypeId" />
            <param name="disable" mapproperty="Disabled" />
            <param name="disabledownlines" mapproperty="DisabledDownlines" />
            <param name="subaccid" mapproperty="SubAccId" />
            <param name="userid" mapproperty="UserId" />
            <param name="uplineid" mapproperty="UplineId" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
            <param name="ip" mapproperty="Ip" />
          </params>
          <results>
            <column name="errcode" mapproperty="ErrorCode" />
            <column name="errmsg" mapproperty="ErrorMessage" />
          </results>
        </sp>
      </sps>
    </product>
    <product id="livecasino" hascheckall="false" reloadafterupdate="true" hidebettypes="" warning="">
      <sps>
        <sp key="" type="SELECT">
          <params />
          <results />
        </sp>
        <sp key="Acc_CustomerUpdDisableLiveCS" type="UPDATE">
          <params>
            <param name="custid" mapproperty="CustId" />
            <param name="disabledlivecs" mapproperty="Disabled" />
            <param name="enabledownlineslivecs" mapproperty="DisabledDownlines" reverse="true" />
            <param name="subaccid" mapproperty="SubAccId" />
            <param name="userid" mapproperty="UserId" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
            <param name="ip" mapproperty="Ip" />
          </params>
          <results>
            <column name="errcode" mapproperty="ErrorCode" />
            <column name="errmsg" mapproperty="ErrorMessage" />
          </results>
        </sp>
      </sps>
    </product>
    <product id="racing" hascheckall="false" reloadafterupdate="true" hidebettypes="" warning="">
      <sps>
        <sp key="Acc_CustomerSelHRStatus" type="SELECT">
          <params>
            <param name="custid" mapproperty="CustId" />
            <param name="roleid" mapproperty="Level" />
            <param name="uplineid" mapproperty="UplineId" />
            <param name="hasdownline" mapproperty="HasDownline" />
          </params>
          <results>
            <column name="username" mapproperty="Username" />
            <column name="sporttypeid" mapproperty="SportTypeId" />
            <column name="bettypeid" mapproperty="BetTypeId" />
            <column name="disable" mapproperty="Disabled" />
            <column name="disableUplines" mapproperty="DisabledUplines" />
            <column name="disableDownlines" mapproperty="DisabledDownlines" />
          </results>
        </sp>
        <sp key="Acc_CustomerUpdHRStatus" type="UPDATE">
          <params>
            <param name="custid" mapproperty="CustId" />
            <param name="bettype" mapproperty="BetTypeId" />
            <param name="disable" mapproperty="Disabled" />
            <param name="disabledownlines" mapproperty="DisabledDownlines" />
            <param name="subaccid" mapproperty="SubAccId" />
            <param name="userid" mapproperty="UserId" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
            <param name="ip" mapproperty="Ip" />
          </params>
          <results>
            <column name="errcode" mapproperty="ErrorCode" />
            <column name="errmsg" mapproperty="ErrorMessage" />
          </results>
        </sp>
      </sps>
    </product>
  </products>
</enablestatus>