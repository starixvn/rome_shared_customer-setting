@using Fanex.CustomerSetting.EnableStatus.AllInOne.Models;
@using Fanex.CustomerSetting.EnableStatus.AllInOne.Resources;
@using Newtonsoft.Json;
@using Newtonsoft.Json.Serialization;
@model EnableStatusModel
@{
    Layout = null;
    var model = JsonConvert.SerializeObject(Model, Formatting.Indented,
        new JsonSerializerSettings
        {
            ContractResolver = new CamelCasePropertyNamesContractResolver(),
            NullValueHandling = NullValueHandling.Ignore
        });
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/EnableStatus/Styles/EnableStatus.less")" rel="stylesheet" type="text/css" />
<div id="ng-app"  data-ng-app="enableStatusApp" data-ng-controller="EnableStatusController" data-ng-init="Init()" style="display: none">
    <div id="errMsg" style="display: none" class="successMsg"></div>
    <div class="errMsg" style="color: #ff5411" data-ng-hide="!model.warning || model.warning == ''">{{model.warning}}</div>
    <table class="tableInfo" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td colspan="2" class="bold bgTitle c" style="border-bottom: none !important">
                <div>
                    <div style="float: left" data-ng-hide="model.hasCheckAll == false">
                        <input data-ng-disabled="isDisabledAll" id="chkAll" type="checkbox" data-ng-click="CheckAll()" />@EnableStatusResources.all
                    </div>
                    <div style="text-align: center">
                        {{(context.level == 1 ? '@EnableStatusResources.member' : context.level == 2 ? '@EnableStatusResources.agent' : context.level == 3 ? '@EnableStatusResources.master' : '@EnableStatusResources.super') + ': ' + model.username}}
                    </div>
                </div>
            </td>
        </tr>
    </table>
    <div>
    <table class="tableInfo" cellpadding="0" cellspacing="0" border="0" data-ng-repeat="group in sortedModel">
        <tr data-ng-hide="sortedModel.length == 1"><td colspan="2" class="bold bgHeader">{{group.sportTypeName}}</td></tr>
        <tr data-ng-repeat="item in group" data-ng-init="item.disable = false; item.enable = !item.disabled; item.preVal = item.enable; item.disableDownline = true; item.enableDownline = !item.disabledDownlines; item.preValDownline = item.enableDownline" data-ng-hide="item.hide" >
            <td style="border-bottom: none !important">
                <input id="{{(item.hide) + '_' + item.betTypeId}}" name="betTypes0" type="checkbox" data-ng-click="item.disable = !item.enable; item.isDisabledDownlines = !item.enableDownline; CheckStatus({{item.preVal}}, this)" data-ng-model="item.enable" data-ng-disabled="item.disabledUplines || item.betTypeId == 0 || !context.enableUplines" /><span>{{item.enableText}}</span>
            </td>
            <td style="border-bottom: none !important">
                <input id="{{item.betTypeId}}" data-ng-click="CheckDownline({{item.betTypeId}}, this)" name="betTypes1" data-ng-hide="context.level == 1 || !context.hasDownline || context.hideDownline" type="checkbox" data-ng-change="item.disabledDownlines = !item.enableDownline" data-ng-model="item.enableDownline" data-ng-disabled="{{ item.betTypeId == 0 ? !item.enable : item.disableDownline }}" /><span  data-ng-hide="context.level == 1 || !context.hasDownline || context.hideDownline">{{item.enableDownlinesText}}</span>
            </td>
        </tr>            
    </table> 
    </div>
    <table class="tableInfo" cellpadding="0" cellspacing="0" border="0">
        <tr style="height: 1px">
            <td colspan="2" style="border-top: none; border-left: none; border-right: none"></td>
        </tr>
    </table>  
    <div style="text-align: right" >
        <input class="buttonPopup" type="button" value="@EnableStatusResources.submit" data-ng-click="isDisabledAll == true || !context.enableUplines ? void() : Update()" style="margin-right: 0" />
    </div>
</div>
<script type="text/javascript">  
    var successMsg = '@EnableStatusResources.successMsg';
    var errMsgAccountDisabled = '@EnableStatusResources.accountDisabled';      
    var model = @Html.Raw(model);
    function resolveClientUrl(relativePath){
        return '@Url.Content("~/")' + relativePath;
    }
</script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/EnableStatus/Scripts/EnableStatus.js")" type="text/javascript"></script>