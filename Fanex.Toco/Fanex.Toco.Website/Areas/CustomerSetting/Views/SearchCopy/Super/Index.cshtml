@model Fanex.Tarus.Customer.CreditCustomer.Entities.CustomerSettingView
@{
    ViewBag.Title = "Search and Copy Super";
    Layout = "~/Areas/CustomerSetting/Views/SearchCopy/Shared/_Layout.cshtml";
}
@section Styles
{
    <link rel="Stylesheet" type="text/css" href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/Areas/CustomerSetting/Views/SearchCopy/SearchCopyCss")" />
}
@section scripts
{    
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Views/SearchCopy/Scripts/Libs/angular.min.js")"></script>    
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Views/SearchCopy/Scripts/ModuleSearchCopy.js")"></script>    
}
<script type="text/javascript">
    var superId = @Model.CustId;
    var superUserName = "@Model.CustUserName";
</script>

<div id="divSearchCopy" ng-controller="SearchCopyController">
    <div id="errorMsg" class="validation-summary-errors hidden" data-valmsg-summary="true">
        <div id="nameReqErr" style="display: none" class="alertboxerr">
            <div>
                Please Enter User Name.</div>
        </div>
        <div id="superNotExistedErr" style="display: none" class="alertboxerr">
            <div>
                The super doesn’t exist!</div>
        </div>        
    </div>
    <div class="formPanel">
        <div id="panelStep1" class="step-active">
            <span class="normal">Step 1: Search Existing Supper</span></div>
        <div id="panelStep2" class="step-inactive">
            <span class="normal">Step 2: Enter Information</span></div>
    </div>
    @using (Html.BeginForm("Home", "Index", FormMethod.Post, new { id = "formSearchExistingSupper", @novalidate = "" }))
    {                                
        <div id="step1">
            <div style="clear: both; height: 1px">
                &nbsp;</div>
            <div class="formauto">
                <div class="row username">
                    <div class="grid2">
                    </div>
                    <div class="grid2">
                        <label>
                            Username</label></div>
                    <div class="grid5">
                        <input id="existedUserName" type="text" ng-model="existedUser.username" size="30" required />
                        <span id="checkExisted" class="success" style="display:none"></span>
                    </div>
                </div>
                <div class="newdoubleline">
                    &nbsp;</div>
                <div class="row">
                    <div class="grid1">
                    </div>
                    <div class="grid8">
                        <span class="start">All settings will be copied from username existed.</span>
                        <br />
                        <span class="start">Special, AutoSuspend and Internal status will not be copied from
                            the existing super.</span>
                    </div>
                </div>
                <div class="newdoubleline">
                    &nbsp;</div>
                <div class="row">
                    <div class="grid1">
                    </div>
                    <div class="grid2">
                        <input id="step1Next" type="button" value="Next >" />
                    </div>
                </div>
            </div>
        </div>
        <div id="step2">
            <div class="newline">
                &nbsp;</div>
            <div class="row tabsports">
                <div id="tabGenealInfomation" class="tab-active" ng-click="showSetting('#divGeneralInforamtion','#tabGenealInfomation');">
                    <span>General Information</span></div>
                <div id="tabSportsbook" class="tab-inactive" ng-click="showSetting('#divSportsbook','#tabSportsbook');">
                    <span>Sportsbook</span></div>
            </div>
            <div class="settingInfo">
                <div id="divGeneralInforamtion">
                    <table class="tblcollapse" style="width: 900px; margin-bottom: 10px;">
                        <tr class="title">
                            <td colspan="4">
                                General Information
                            </td>
                        </tr>
                        <tr>
                            <td class="l" style="width: 15%">
                                UserName
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.username" size="30" required />
                            </td>
                            <td class="l" style="width: 15%">
                                Password
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.password" size="30" required />
                            </td>
                        </tr>
                        <tr>
                            <td class="l" style="width: 15%">
                                First Name
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.firstname" size="30" />
                            </td>
                            <td class="l" style="width: 15%">
                                Last Name
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.lastname" size="30" />
                            </td>
                        </tr>
                        <tr>
                            <td class="l" style="width: 15%">
                                Phone
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.phone" size="30" />
                            </td>
                            <td class="l" style="width: 15%">
                                Mobile Phone
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.mobilephone" size="30" />
                            </td>
                        </tr>
                        <tr>
                            <td class="l" style="width: 15%">
                                Site
                            </td>
                            <td class="l" style="width: 35%">
                                <select name="listSite" id="listSite" class="select-group">
                                    <option>Select</option>
                                    @* @foreach (Sites sites in (List<Sites>)ViewData["listSite"])
                                    {
                                        <optgroup label="@sites.Name">
                                            @foreach (Site site in sites.ListSite)
                                            {
                                                <option id="@site.Id" value="@site.Name" >@site.Name</option>
                                            }
                                        </optgroup>
                                    }*@
                                </select>
                            </td>
                            <td class="l" style="width: 15%">
                                Fax
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.fax" size="30" />
                            </td>
                        </tr>
                        <tr>
                            <td class="l" style="width: 15%">
                                Max Credit
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.maxcredit" size="30" />
                            </td>
                            <td class="l" style="width: 15%">
                                Currency
                            </td>
                            <td class="l" style="width: 35%">
                                <select ng-model="currency" ng-options="c.name for c in newUser.currencylist" name="listCurrency"
                                    id="listCurrency" class="select-group" required>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td class="l" style="width: 15%">
                                Internal User
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="checkbox" ng-model="newUser.internaluser">
                            </td>
                        </tr>
                    </table>
                </div>
                <div id="divSportsbook">
                    <table class="tblcollapse" style="width: 900px; margin-bottom: 10px;">
                        <tr class="title">
                            <td colspan="6">
                                Sportsbook
                            </td>
                        </tr>
                        <tr>
                            <td class="l" style="width: 15%">
                                First Name
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.firstname" size="30" />
                            </td>
                            <td class="l" style="width: 15%">
                                Last Name
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.lastname" size="30" />
                            </td>
                        </tr>
                        <tr>
                            <td class="l" style="width: 15%">
                                Phone
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.phone" size="30" />
                            </td>
                            <td class="l" style="width: 15%">
                                Mobile Phone
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.mobilephone" size="30" />
                            </td>
                        </tr>
                        <tr>
                            <td class="l" style="width: 15%">
                                Max Credit
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.maxcredit" size="30" />
                            </td>
                            <td class="l" style="width: 15%">
                                Fax
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="text" ng-model="newUser.fax" size="30" />
                            </td>
                        </tr>
                        <tr>
                            <td class="l" style="width: 15%">
                                Closed
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="checkbox" ng-model="newUser.closed">
                            </td>
                            <td class="l" style="width: 15%">
                                Suspended
                            </td>
                            <td class="l" style="width: 35%">
                                <input type="checkbox" ng-model="newUser.suspended">
                            </td>
                        </tr>
                    </table>
                    @Html.Partial("~/Areas/CustomerSetting/Views/SearchCopy/Shared/CustInfoPartialView.cshtml", Model)
                    @*betting limit and position taking*@
                    @Html.Partial("~/Areas/CustomerSetting/Views/SearchCopy/Shared/BettingLimitAndPositionTakingPartialView.cshtml")
                </div>
            </div>
            <div class="newline">
                &nbsp;</div>
            <div class="row">
                <div class="grid3">
                    <input id="step2Back" type="button" value="< Previous" />
                </div>
                <div class="grid3">
                    <input id="step2Submit" type="button" value="Submit" />
                </div>
            </div>
        </div>
    }
</div>
