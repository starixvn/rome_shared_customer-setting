<div class="formauto">
    <div class="row username">
        <div class="grid2">
        </div>
        <div class="grid2">
            <label>
                Username</label></div>
        <div class="grid6">
            <input id="existedUserName" type="text" ng-model="existedUser.username" size="30"
                required />
            <span id="checkExisted" class="success" style="display: none"></span>
        </div>
    </div>
    <div class="newdoubleline">
        &nbsp;</div>
    <div class="row">
        <div class="grid1">
        </div>
        <div class="grid8">
            <span class="start">All settings will be copied from username existed.</span>
            <br />
            <span class="start">Special, AutoSuspend and Internal status will not be copied from
                the existing super.</span>
        </div>
    </div>
    <div class="newdoubleline">
        &nbsp;</div>
    <div class="row">
        <div class="grid1">
        </div>
        <div class="grid2">
            <input id="step1Next" type="button" class="btnStep" value="Next >" />
        </div>
    </div>
</div>
