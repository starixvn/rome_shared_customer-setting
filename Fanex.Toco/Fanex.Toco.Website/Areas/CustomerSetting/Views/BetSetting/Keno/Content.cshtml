@using Fanex.CustomerSetting.Module.Core
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model IEnumerable<Fanex.CustomerSetting.Module.Keno.KenoSetting.Entities.BetSetting>
@{
    var bettingLimit = Newtonsoft.Json.JsonConvert.SerializeObject(Model, Newtonsoft.Json.Formatting.None, new Newtonsoft.Json.JsonSerializerSettings
    {
        ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver(),
        NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore
    });

    var id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
    var userId = Utils.ToInt32(Request.RequestContext.RouteData.Values["userId"]);
    var siteName = Request.RequestContext.RouteData.Values["siteName"];    
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Keno/Styles/Keno.css")" rel="stylesheet" type="text/css" />
<div id="ng-app" ng-app="bettingApp" ng-controller="Fanex.CustomerSetting.Betting.Keno" ng-init="Init()" style="width: 815px; display: none">
    <div id="errMsg" style="display: none" class="errMsg">
        </div>
        <div class="title C bold header">
            Update Bet Setting: @ViewBag.Username
        </div>
        <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
            <tr>
                <td class="title titleWidth"></td>
                <td class="title bold C betWidth">Min Bet</td>
                <td class="title bold C betWidth">Max Bet</td>
                <td class="title bold C betWidth">Max Per Match</td>
            </tr>
            <tr ng-repeat="betting in bettingLimits" ng-init="betting.bgClass = '';">
                <td id="_{{betting.betTypeId}}" class="title {{betting.className}}" ng-init="betting.className = betting.betTypeId == 1501" ng-click="Copy(this)" title="{{betting.title}}">{{betting.betTypeName}}</td>
                <td class="{{betting.bgClass}}">
                    <input ng-readonly="betting.bgClass == 'inactive'" style="text-align: right; width: 100px" id="txt{{betting.betTypeId}}Min" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showminBetMax = betting.upline.minBet > 0; betting.minBetFormated = betting.minBet.formatNumber(); betting.preValMinBet = betting.minBetFormated" type="text" class="BettingLimitTextBox" ng-model="betting.minBetFormated" ng-change="betting.minBet = betting.minBetFormated.replaceAll(',', '').formatNumber(); betting.isBetSettingUpdated = betting.minBet != betting.preValMinBet" />
                    <span ng-show="betting.showminBetMax">>={{betting.upline.minBet.formatNumber()}}</span>
                </td>
                <td class="{{betting.bgClass}}">
                    <input ng-readonly="betting.bgClass == 'inactive'" style="text-align: right; width: 100px" id="txt{{betting.betTypeId}}Max" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showmaxBetMin = betting.upline.maxBet > 0; betting.maxBetFormated = betting.maxBet.formatNumber(); betting.preValMaxBet = betting.maxBetFormated" type="text" class="BettingLimitTextBox" ng-model="betting.maxBetFormated" ng-change="betting.maxBet = betting.maxBetFormated.replaceAll(',', '').formatNumber(); betting.isBetSettingUpdated = betting.minBet != betting.preValMaxBet" />
                    <span ng-show="betting.showmaxBetMin"><={{betting.upline.maxBet.formatNumber()}}</span>
                </td>
                <td class="{{betting.bgClass}}">
                    <input ng-readonly="betting.bgClass == 'inactive'" style="text-align: right; width: 100px" id="txt{{betting.betTypeId}}MaxPerMatch" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showmaxPerMatchMax = betting.upline.maxPerMatch > 0; betting.maxPerMatchFormated = betting.maxPerMatch.formatNumber(); betting.preValMaxPerMatch = betting.maxPerMatchFormated" type="text" class="BettingLimitTextBox" ng-model="betting.maxPerMatchFormated" ng-change="betting.maxPerMatch = betting.maxPerMatchFormated.replaceAll(',', '').formatNumber(); betting.isBetSettingUpdated = betting.minBet != betting.preValMaxPerMatch" />
                    <span ng-show="betting.showmaxPerMatchMax"><={{betting.upline.maxPerMatch.formatNumber()}}</span>
                </td>
            </tr>
    </table>
    <div style="text-align: right">
        <input id="btnKeno" class="buttonPopup" type="button" value="Submit" />
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Scripts/BetSetting.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Keno/Scripts/KenoController.js")" type="text/javascript"></script>
<script type="text/javascript">
    parent.$('#tab1').removeClass('ui-tabs-active ui-state-active');
    parent.$('#tab2').removeClass('ui-tabs-active ui-state-active');
    parent.$('#tab4').removeClass('ui-tabs-active ui-state-active');
    parent.$('#tab5').removeClass('ui-tabs-active ui-state-active');
    parent.$('#tab6').removeClass('ui-tabs-active ui-state-active');
    parent.$('#tab7').removeClass('ui-tabs-active ui-state-active');

    parent.$('#tabs-1').hide();
    parent.$('#tabs-2').hide();
    parent.$('#tabs-4').hide();
    parent.$('#tabs-5').hide();
    parent.$('#tabs-6').hide();
    parent.$('#tabs-7').hide();

    var model = JSON.parse(Fanex.CustomerSetting.Core.DecodeHtml('@bettingLimit'));
    var custId = parseInt('@id');
    var uplineId = parseInt('@uplineId');
    var userId = parseInt('@userId');
    var siteName = '@siteName';
    var syncCasino = '@ViewBag.SyncCasino';
    var syncLiveCasino = '@ViewBag.SyncLiveCasino';
    var syncBingo = '@ViewBag.SyncBingo';

    function toUrl(relativeUrl) {
        return '@Url.Content("~/CustomerSetting/BetSetting/")' + relativeUrl;
    }

    $(document).ready(function () {
        if (syncCasino == 'False') {
            parent.$('#tab6').remove();
        }

        if (syncBingo == 'False') {
            parent.$('#tab5').remove();
        }

        if (syncLiveCasino == 'False') {
            parent.$('#tab4').remove();
        }

        parent.$('#tab7').addClass('ui-tabs-active ui-state-active');
        parent.$('#tabs-7').show();        

        $('.buttonPopup').bind('click', function () {
            Fanex.CustomerSetting.Betting.Keno.Update(function (data) {
                if (data.errorCode == "0") {
                    var timeout = setTimeout(function () {
                        clearTimeout(timeout);

                        $('#ng-app').hide();

                        Fanex.CustomerSetting.Core.BlockUI();

                        document.location.reload(true);
                    }, 2000);
                }
            });
        });
    });
</script>