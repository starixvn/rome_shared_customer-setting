@using Fanex.PTEngine.BusinessObjects
@using Fanex.CustomerSetting.Module.Core
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model Fanex.CustomerSetting.Module.BetSetting.ViewModels.LiveCasinoModel
@{
    var bettingLimit = JsonConvert.SerializeObject(Model, Formatting.None , new JsonSerializerSettings
    { 
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });

    var id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
    var userId = Utils.ToInt32(Request.RequestContext.RouteData.Values["userId"]);
    var siteName = Request.RequestContext.RouteData.Values["siteName"];    
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/LiveCasino/Styles/LiveCasino.css")" rel="stylesheet" type="text/css" />
<div id="ng-app" ng-app="bettingApp" ng-controller="Fanex.CustomerSetting.Betting.LiveCasino" style="width: 815px; display: none">
        <div id="warningMsg" style="display: none; color: Red" class="errMsg">Unchecking all stake levels will affect and apply to all downlines</div>
        <div id="errMsg" style="display: none" class="errMsg">
        </div>
        <div class="title C bold header">
            Update Bet Setting: @ViewBag.Username
        </div>
        <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
            <tr>
                <td class="title bold memberWinLimitWidth noneBorderRight">Member Win Limit</td>
                <td class="title bettingLimitWidth noneBorderLR"></td>
                <td class="title noneBorderLeft"></td>
            </tr>
            <tr>
                <td class="bold R">Maximum Win</td>
                <td class="bold">
                    <select id="winLimit" style="width: 80px !important" ng-model="limit" ng-change="model.memberWinLimit.maxWinLimit = limit">
                        <option value="{{limit}}" ng-repeat="limit in model.memberWinLimit.limits" ng-init="isUnlimited = limit == 0; limitText = isUnlimited ? 'Unlimited' : limit + 'X'" ng-selected="limit == model.memberWinLimit.maxWinLimit">{{limitText}}</option>
                    </select>
                    &nbsp;<span class="normal">on given credit</span>
                </td>
                <td class="bold">
                    <input type="checkbox" id="chkDailyAutoReset" ng-model="model.memberWinLimit.isDailyAutoReset" />
                    <label class="normal" for="chkDailyAutoReset">Daily auto reset limit (at 12 noon GMT + 8)</label>
                </td>
            </tr>
            <tr>
                <td class="title bold" colspan="3">Game Setting</td>
            </tr>
            <tr>
                <td class="bold R">Game Type</td>
                <td class="bold" colspan="2">Betting Limit</td>
            </tr>
            <tr ng-repeat="gameType in gameTypes">
                <td class="R">{{gameType.name}}</td>
                <td colspan="2">
                    <div class="floatLeft" ng-repeat="betting in gameType.bettingLimit">
                        <input type="checkbox" ng-model="betting.isSelected" ng-init="changed = betting.isSelected" ng-click="betting.isDirty = changed != betting.isSelected; ChangeLimit(this)" />
                        <span>{{betting.text}}</span>
                    </div>
                </td>
            </tr>
        </table>
        <div style="text-align: right">
            <input class="buttonPopup" type="button" value="Submit" />
        </div>
    </div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Scripts/BetSetting.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/LiveCasino/Scripts/LiveCasinoController.js")" type="text/javascript"></script>
    <script type="text/javascript">
        var model = JSON.parse(Fanex.CustomerSetting.Core.DecodeHtml('@bettingLimit'));
        var custId = parseInt('@id');
        var uplineId = parseInt('@uplineId');
        var userId = parseInt('@userId');
        var siteName = '@siteName';
        var syncCasino = '@ViewBag.SyncCasino';
        var syncLiveCasino = '@ViewBag.SyncLiveCasino';
        var syncBingo = '@ViewBag.SyncBingo';

        function toUrl(relativeUrl) {
            return '@Url.Content("~/CustomerSetting/BetSetting/")' + relativeUrl;
        }

        $(document).ready(function () {
            if (syncCasino == 'False') {
                $('#tab6').remove();
            }

            if (syncBingo == 'False') {
                $('#tab5').remove();
            }

            if (syncLiveCasino == 'False') {
                $('#tab4').remove();
            }

            $('#tab4').addClass('ui-tabs-active ui-state-active');
            $('#tab1').removeClass('ui-tabs-active ui-state-active');
            $('#tab2').removeClass('ui-tabs-active ui-state-active');
            $('#tab3').removeClass('ui-tabs-active ui-state-active');
            $('#tab5').removeClass('ui-tabs-active ui-state-active');
            $('#tab6').removeClass('ui-tabs-active ui-state-active');

            $('.buttonPopup').bind('click', function () {
                Fanex.CustomerSetting.Betting.LiveCasino.Update(function (data) {
                    if (data.errorCode == "0") {
                        var timeout = setTimeout(function () {
                            clearTimeout(timeout);

                            $('#ng-app').hide();

                            Fanex.CustomerSetting.Core.BlockUI();

                            document.location.reload(true);
                        }, 2000);
                    }
                });
            });
        });
    </script>