@using Fanex.PTEngine.BusinessObjects
@using Fanex.CustomerSetting.Module.Core
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model Fanex.CustomerSetting.Module.BetSetting.ViewModels.CasinoModel
@{
    var bettingLimit = JsonConvert.SerializeObject(Model, Formatting.None , new JsonSerializerSettings
    { 
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });

    var id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
    var userId = Utils.ToInt32(Request.RequestContext.RouteData.Values["userId"]);
    var siteName = Request.RequestContext.RouteData.Values["siteName"];
    
    Layout = "~/Areas/CustomerSetting/Views/BetSetting/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Casino/Styles/Casino.css")" rel="stylesheet" type="text/css" />
}
@section Casino{    
    <div ng-controller="Fanex.CustomerSetting.Betting.Casino" ng-init="Init()" style="width: 815px">
        <div id="errMsg" style="display: none" class="errMsg">
        </div>
        <div style="text-align: right" ng-hide="model == null" >
            <input class="buttonPopup" type="button" value="Submit" />
        </div>
        <div class="title C bold header">
            Update Bet Setting: @ViewBag.Username
        </div>
        <div ng-hide="model != null" style="color: Red; height: 25px; border: 1px solid #CCC" class="C">There is no information available.</div>
        <table class="tableInfo" border="1" cellpadding="0" cellspacing="0" ng-hide="model == null">
            <tr>
                <td colspan="3" style="border: none">
                    <table class="tableInfo" border="0" cellpadding="0" cellspacing="0">
                        <tr>
                            <td class="bold R">Accumulated Transferable Amount</td>
                            <td style="text-indent: 6px">{{customerModel.totalWinLoss.formatNumber()}}</td>
                        </tr>
                        <tr>
                            <td class="bold R">Member Max Transfer Credit</td>
                            <td>
                                <input id="maxTransferCredit" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" type="text" ng-model="customerModel.maxTransferCredit" style="text-align: left" />
                                <input id="chkDailyAutoReset" type="checkbox" ng-model="customerModel.isAutoReset" />
                                <label class="normal" for="chkDailyAutoReset">Daily auto reset limit (at 12 noon GMT + 8)</label>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>({{customerModel.minTransferCreditLimit.formatNumber()}} - {{customerModel.maxWin == 0 ? 'No limited' : customerModel.maxWin.formatNumber()}})</td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td colspan="3" style="border: none">
                    <table class="tableInfo" border="0" cellpadding="0" cellspacing="0">
                        <tr ng-repeat="gameKind in gameKinds">
                            <td class="widthBingoTitle noneBorderTop bold">{{gameKind.gameGroupName}}</td>
                            <td class="noneBorderTop" style="border: none">
                                <table class="tableInfo" border="0" cellpadding="0" cellspacing="0">
                                    <tr ng-repeat="gameType in gameKind.gameTypes">
                                        <td class="widthBingoTitle noneBorderLeft noneBorderTop">{{gameType.gameTypeName}}</td>
                                        <td class="noneBorderLeft noneBorderTop">
                                            <div class="floatLeft">                                              
                                                <div class="floatLeft">Betting Limit:&nbsp;</div>
                                                <div class="floatLeft" ng-repeat="betting in gameType.bettingLimits">
                                                    <div class="floatLeft">
                                                        <input type="checkbox" ng-model="betting.isChecked" /><span>{{betting.stakeLevelName}}</span>
                                                    </div>                                        
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </table>                                
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        <div style="text-align: right" ng-hide="model == null" >
            <input class="buttonPopup" type="button" value="Submit" />
        </div>
    </div>
}
@section Scripts{
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Casino/Scripts/CasinoController.js")" type="text/javascript"></script>
    <script type="text/javascript">
        var model = JSON.parse(Fanex.CustomerSetting.Core.DecodeHtml('@bettingLimit'));
        var custId = parseInt('@id');
        var uplineId = parseInt('@uplineId');
        var userId = parseInt('@userId');
        var siteName = '@siteName';
        var syncCasino = '@ViewBag.SyncCasino';
        var syncLiveCasino = '@ViewBag.SyncLiveCasino';
        var syncBingo = '@ViewBag.SyncBingo';

        function toUrl(relativeUrl) {
            return '@Url.Content("~/CustomerSetting/BetSetting/")' + relativeUrl;
        }

        $(document).ready(function () {
            if (syncCasino == 'False') {
                $('#tab6').remove();
            }

            if (syncBingo == 'False') {
                $('#tab5').remove();
            }

            if (syncLiveCasino == 'False') {
                $('#tab4').remove();
            }

            $('#tab6').addClass('ui-tabs-active ui-state-active');
            $('#tab1').removeClass('ui-tabs-active ui-state-active');
            $('#tab2').removeClass('ui-tabs-active ui-state-active');
            $('#tab3').removeClass('ui-tabs-active ui-state-active');
            $('#tab4').removeClass('ui-tabs-active ui-state-active');
            $('#tab5').removeClass('ui-tabs-active ui-state-active');

            $('.buttonPopup').bind('click', function () {
                Fanex.CustomerSetting.Betting.Casino.Update(function (data) {
                    if (data.errorCode == "0") {
                        var timeout = setTimeout(function () {
                            clearTimeout(timeout);

                            Fanex.CustomerSetting.Core.BlockUI();

                            document.location.reload(true);
                        }, 2000);
                    }
                });
            });
        });
    </script>
}