@model Fanex.PTEngine.BusinessObjects.ICustomer
@{
    var bettingLimit = Newtonsoft.Json.JsonConvert.SerializeObject(Model, Newtonsoft.Json.Formatting.None , new Newtonsoft.Json.JsonSerializerSettings
    { 
        ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver(),
        NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore
    });

    var id = Fanex.CustomerSetting.Module.Core.Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Fanex.CustomerSetting.Module.Core.Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
    var userId = Fanex.CustomerSetting.Module.Core.Utils.ToInt32(Request.RequestContext.RouteData.Values["userId"]);
    var siteName = Request.RequestContext.RouteData.Values["siteName"];
    
    Layout = "~/Areas/CustomerSetting/Views/BetSetting/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/VirtualSports/Styles/VirtualSports.css")" rel="stylesheet" type="text/css" />
}
@section VirtualSports{
<div ng-controller="Fanex.CustomerSetting.Betting.VirtualSports" ng-init="Init()" style="width: 815px">
    <div id="errMsg" style="display: none" class="errMsg">
        </div>
        <div class="title C bold header">
            Update Bet Setting: @ViewBag.Username
        </div>
        <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
            <tr>
                <td class="title titleWidth"></td>
                <td class="title bold C betWidth">Min Bet</td>
                <td class="title bold C betWidth">Max Bet</td>
                <td class="title bold C betWidth">Max Per Match</td>
            </tr>
            <tr ng-repeat="betting in bettingLimits">
                <td id="_{{betting.id}}" class="title">{{betting.name}}</td>
                <td>
                    <input id="txt{{betting.id}}Min" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showminBetMax = betting.minBetMax > 0; betting.minBetFormated = betting.minBet.formatNumber(); betting.preValMinBet = betting.minBetFormated" type="text" class="BettingLimitTextBox" ng-model="betting.minBetFormated" ng-change="betting.minBet = betting.minBetFormated.replaceAll(',', '').formatNumber()" />
                    <span ng-show="betting.showminBetMax">>={{betting.minBetMax.formatNumber()}}</span>
                </td>
                <td>
                    <input id="txt{{betting.id}}Max" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showmaxBetMin = betting.maxBetMin > 0; betting.maxBetFormated = betting.maxBet.formatNumber(); betting.preValMaxBet = betting.maxBetFormated" type="text" class="BettingLimitTextBox" ng-model="betting.maxBetFormated" ng-change="betting.maxBet = betting.maxBetFormated.replaceAll(',', '').formatNumber()" />
                    <span ng-show="betting.showmaxBetMin"><={{betting.maxBetMin.formatNumber()}}</span>
                </td>
                <td>
                    <input id="txt{{betting.id}}MaxPerMatch" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showmaxPerMatchMax = betting.maxPerMatchMax > 0; betting.maxPerMatchFormated = betting.maxPerMatch.formatNumber(); betting.preValMaxPerMatch = betting.maxPerMatchFormated" type="text" class="BettingLimitTextBox" ng-model="betting.maxPerMatchFormated" ng-change="betting.maxPerMatch = betting.maxPerMatchFormated.replaceAll(',', '').formatNumber()" />
                    <span ng-show="betting.showmaxPerMatchMax"><={{betting.maxPerMatchMax.formatNumber()}}</span>
                </td>
            </tr>
    </table>
    <div style="text-align: right" >
        <input id="btnVirtualSports" class="buttonPopup" type="button" value="Submit" />
    </div>
</div>
}
@section Scripts{
<script type="text/javascript">
    var model = JSON.parse(Fanex.CustomerSetting.Core.DecodeHtml('@bettingLimit'));
    var custId = parseInt('@id');
    var uplineId = parseInt('@uplineId');
    var userId = parseInt('@userId');
    var siteName = '@siteName';
    var syncCasino = '@ViewBag.SyncCasino';
    var syncLiveCasino = '@ViewBag.SyncLiveCasino';
    var syncBingo = '@ViewBag.SyncBingo';

    function toUrl(relativeUrl) {
        return '@Url.Content("~/CustomerSetting/BetSetting/")' + relativeUrl;
    }

    $(document).ready(function () {
        if (syncCasino == 'False') {
            $('#tab6').remove();
        }

        if (syncBingo == 'False') {
            $('#tab5').remove();
        }

        if (syncLiveCasino == 'False') {
            $('#tab4').remove();
        }

        $('#tab3').addClass('ui-tabs-active ui-state-active');
        $('#tab1').removeClass('ui-tabs-active ui-state-active');
        $('#tab2').removeClass('ui-tabs-active ui-state-active');
        $('#tab4').removeClass('ui-tabs-active ui-state-active');
        $('#tab5').removeClass('ui-tabs-active ui-state-active');
        $('#tab6').removeClass('ui-tabs-active ui-state-active');

        $('.buttonPopup').bind('click', function () {
            Fanex.CustomerSetting.Betting.VirtualSports.Update(function (data) {
                if (data.errorCode == "0") {
                    var timeout = setTimeout(function () {
                        clearTimeout(timeout);

                        Fanex.CustomerSetting.Core.BlockUI();

                        document.location.reload(true);
                    }, 2000);
                }
            });
        });
    });
</script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/VirtualSports/Scripts/VirtualSportsController.js")" type="text/javascript"></script>
}