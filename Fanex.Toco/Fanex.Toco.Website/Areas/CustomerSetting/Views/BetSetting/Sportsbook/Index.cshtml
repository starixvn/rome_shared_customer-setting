@using Fanex.PTEngine.BusinessObjects
@using Fanex.CustomerSetting.Module.Core
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model IBettingLimit<BettingLimitItem>
@{
    var bettingLimit = JsonConvert.SerializeObject(Model, Formatting.None , new JsonSerializerSettings
    { 
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });

    var id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
    var userId = Utils.ToInt32(Request.RequestContext.RouteData.Values["userId"]);
    var siteName = Request.RequestContext.RouteData.Values["siteName"];
    
    Layout = "~/Areas/CustomerSetting/Views/BetSetting/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Sportsbook/Styles/Sportsbook.css")" rel="stylesheet" type="text/css" />
}
@section Sportsbook{
    <div ng-controller="Fanex.CustomerSetting.Betting.Sportsbook" ng-init="Init()" style="width: 815px">
        <div id="errMsg" style="display: none" class="errMsg">
        </div>
        <div class="title C bold header">
            Update Bet Setting: @ViewBag.Username
        </div>
        <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
            <tr>
                <td class="title titleWidth"></td>
                <td class="title bold C betWidth">Min Bet</td>
                <td class="title bold C betWidth">Max Bet</td>
                <td class="title bold C betWidth">Max Per Match</td>
            </tr>
            <tr ng-model="betting.bgClass" class="{{betting.bgClass}}" id="{{betting.resourceKey}}" ng-hide="betting.isNumberGame" ng-init="betting.bgClass = ''; betting.isNumberGame = betting.resourceKey == 'numbergame'; betting.className = betting.id == 1 || betting.id == 2" ng-repeat="betting in bettingLimits">
                <td title="{{betting.title}}" id="_{{betting.resourceKey}}" class="title {{betting.className}} {{betting.bgClass}}" ng-click="Copy(this)">{{betting.name}}</td>
                <td>
                    <input id="txt{{betting.resourceKey}}Min" ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showminBetMax = betting.minBetMax > 0; betting.minBetFormated = betting.minBet.formatNumber(); betting.preValMinBet = betting.minBetFormated" type="text" class="BettingLimitTextBox" ng-model="betting.minBetFormated" ng-change="betting.minBet = betting.minBetFormated.replaceAll(',', '').formatNumber()" />
                    <span ng-show="betting.showminBetMax">>={{betting.minBetMax.formatNumber()}}</span>
                </td>
                <td>
                    <input id="txt{{betting.resourceKey}}Max" ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showmaxBetMin = betting.maxBetMin > 0; betting.maxBetFormated = betting.maxBet.formatNumber(); betting.preValMaxBet = betting.maxBetFormated" type="text" class="BettingLimitTextBox" ng-model="betting.maxBetFormated" ng-change="betting.maxBet = betting.maxBetFormated.replaceAll(',', '').formatNumber()" />
                    <span ng-show="betting.showmaxBetMin"><={{betting.maxBetMin.formatNumber()}}</span>
                </td>
                <td>
                    <input id="txt{{betting.resourceKey}}MaxPerMatch" ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showmaxPerMatchMax = betting.maxPerMatchMax > 0; betting.maxPerMatchFormated = betting.maxPerMatch.formatNumber(); betting.preValMaxPerMatch = betting.maxPerMatchFormated" type="text" class="BettingLimitTextBox" ng-model="betting.maxPerMatchFormated" ng-change="betting.maxPerMatch = betting.maxPerMatchFormated.replaceAll(',', '').formatNumber()" />
                    <span ng-show="betting.showmaxPerMatchMax"><={{betting.maxPerMatchMax.formatNumber()}}</span>
                </td>
            </tr>
            <tr ng-init="betting = bettingLimits[bettingLimits.length - 1]">
                <td colspan="4">
                    <table cellpadding="0" cellspacing="0" class="tableInfo">
                        <tr>
                            <td rowspan="2" class="title titleWidth noneBorderTop noneBorderLeft noneBorderBottom">{{betting.name}}</td>
                            <td class="title bold C numberGameWidth noneBorderTop">Min Bet</td>
                            <td class="title bold C numberGameWidth noneBorderTop">Max Bet</td>
                            <td class="title bold C numberGameWidth noneBorderTop">Max Per Match</td>
                            <td class="title bold C numberGameWidth noneBorderTop noneBorderRight">Max Per Ball</td>
                        </tr>
                        <tr>                        
                            <td class="noneBorderBottom">
                                <input id="txt{{betting.resourceKey}}Min1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showminBetMax = betting.minBetMax > 0; betting.minBetFormated = betting.minBet.formatNumber()" type="text" class="BettingLimitTextBox" ng-model="betting.minBetFormated" ng-change="betting.minBet = betting.minBetFormated.replaceAll(',', '').formatNumber()" />
                                <span ng-show="betting.showminBetMax">>={{betting.minBetMax.formatNumber()}}</span>
                            </td>
                            <td class="noneBorderBottom">
                                <input id="txt{{betting.resourceKey}}Max1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showmaxBetMin = betting.maxBetMin > 0; betting.maxBetFormated = betting.maxBet.formatNumber()" type="text" class="BettingLimitTextBox" ng-model="betting.maxBetFormated" ng-change="betting.maxBet = betting.maxBetFormated.replaceAll(',', '').formatNumber()" />
                                <span ng-show="betting.showmaxBetMin"><={{betting.maxBetMin.formatNumber()}}</span>
                            </td>
                            <td class="noneBorderBottom">
                                <input id="txt{{betting.resourceKey}}MaxPerMatch1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showmaxPerMatchMax = betting.maxPerMatchMax > 0; betting.maxPerMatchFormated = betting.maxPerMatch.formatNumber()" type="text" class="BettingLimitTextBox" ng-model="betting.maxPerMatchFormated" ng-change="betting.maxPerMatch = betting.maxPerMatchFormated.replaceAll(',', '').formatNumber()" />
                                <span ng-show="betting.showmaxPerMatchMax"><={{betting.maxPerMatchMax.formatNumber()}}</span>
                            </td>
                            <td class="noneBorderBottom noneBorderRight">
                                <input id="txt{{betting.resourceKey}}MaxPerBall1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" ng-init="betting.showmaxPerBallMax = betting.maxPerBallMax > 0; betting.maxPerBallFormated = betting.maxPerBall.formatNumber()" type="text" class="BettingLimitTextBox" ng-model="betting.maxPerBallFormated" ng-change="betting.maxPerBall = betting.maxPerBallFormated.replaceAll(',', '').formatNumber()" />
                                <span ng-show="betting.showmaxPerBallMax"><={{betting.maxPerBallMax.formatNumber()}}</span>
                            </td>
                        </tr>
                    </table>
                </td>            
            </tr>
        </table>
        <div style="text-align: right" >
            <input class="buttonPopup" type="button" value="Submit" />
        </div>
    </div>
}
@section Scripts{
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Sportsbook/Scripts/SportsbookController.js")" type="text/javascript"></script>
    <script type="text/javascript">
        var model = JSON.parse(Fanex.CustomerSetting.Core.DecodeHtml('@bettingLimit'));
        var custId = parseInt('@id');
        var uplineId = parseInt('@uplineId');
        var userId = parseInt('@userId');
        var siteName = '@siteName';
        var syncCasino = '@ViewBag.SyncCasino';
        var syncLiveCasino = '@ViewBag.SyncLiveCasino';
        var syncBingo = '@ViewBag.SyncBingo';

        function toUrl(relativeUrl) {
            return '@Url.Content("~/CustomerSetting/BetSetting/")' + relativeUrl;
        }

        $(document).ready(function () {
            if (syncCasino == 'False') {
                $('#tab6').remove();
            }

            if (syncBingo == 'False') {
                $('#tab5').remove();
            }

            if (syncLiveCasino == 'False') {
                $('#tab4').remove();
            }

            $('#tab2').removeClass('ui-tabs-active');

            $('.buttonPopup').bind('click', function () {
                Fanex.CustomerSetting.Betting.Sportsbook.Update(function (data) {
                    if (data.errorCode == "0") {
                        var timeout = setTimeout(function () {
                            clearTimeout(timeout);

                            Fanex.CustomerSetting.Core.BlockUI();

                            document.location.reload(true);
                        }, 2000);
                    }
                });
            });
        });
    </script>
}