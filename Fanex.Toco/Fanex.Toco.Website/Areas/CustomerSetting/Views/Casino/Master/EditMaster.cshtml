@model Fanex.CustomerSetting.Module.Casino.ViewModels.CasinoSettingModel
@{
    var i = 0;
}
<div id="product">
    <div id="errMsg" style="display: none;" class="errMsg">
    </div>
    <div id="arrowUpDown" class="collapse">
    </div>
    <div id="names" style="display: none;" class="names">
    </div>
    <div style="text-align: right">
        <input class="buttonPopup btnTop" type="button" value="Submit" data-bind='click: saveCustomer' />
    </div>
    <div id="info">
        @Html.Action("CustomerInfo", "Customer", new { area = string.Empty, id = Fanex.ExternalAccount.Utilities.Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]), uplineId = Fanex.ExternalAccount.Utilities.Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]) })
    </div>
    <div id="settingContainer">
        <div class="headerPositionTaking noneBorderLR"  style="border-bottom: none">
        Postition Taking</div>
        @foreach (var gameSetting in Model.GameGroups)
        {            
        <table id="casinoGame_@i" class="tableInfo" border="1" cellpadding="1" cellspacing="2">
            <tr>
                <td colspan="2" class="noneBorderL">&nbsp;</td>
                <td class="ptTitle">Super Preset PT</td>
                <td class="ptTitle">Super Auto PT</td>
                <td class="ptTitle">Master Max PT</td>
                <td class="ptTitle">Master Min PT</td>
                <td class="ptTitle noneBorderR">Master Commission</td>
            </tr>
            <tr>
                <td id="rowspanCasino_@i" rowspan="1" class="gameTitle"></td>                
                <td class="ptTitle R" style="width: 135px">Group Setting</td>
                <td class="C">
                    <span class="spanPT">
                        <select id="pt_1" name="pt_1" onchange="PTChanging(this, '')" style="position: relative;">
                        </select>
                        <input type="button" class="btnPTDown" onclick="PT_Reduce('pt_1', 1);" />
                        <input type="button" class="btnPTUp" onclick="PT_Increase('pt_1', 1);" />
                        <input type="button" class="btnPTSub" onclick="PT_Reduce('pt_1', 10);" />
                        <input type="button" class="btnPTAdd" onclick="PT_Increase('pt_1', 10);" />
                    </span>
                </td>
                <td class="C">
                    <span class="spanPT">
                        <input type="checkbox" name="chkAutoPT" id="chkAutoPT" onclick="checkPT(this, '');" style="vertical-align: middle;" />
                        <select id="pt_2" name="pt_2" style="position: relative;" onchange="PTChanging(this, '')">
                        </select>
                        <input type="button" class="btnPTDown" onclick="PT_Reduce('pt_2', 1);" />
                        <input type="button" class="btnPTUp" onclick="PT_Increase('pt_2', 1);" />
                        <input type="button" class="btnPTSub" onclick="PT_Reduce('pt_2', 10);" />
                        <input type="button" class="btnPTAdd" onclick="PT_Increase('pt_2', 10);" />
                    </span>
                </td>
                <td class="C">
                    <span class="spanPT">
                        <select id="pt_3" name="pt_3" onchange="PTChanging(this, '')" style="position: relative;">
                        </select>
                        <input type="button" class="btnPTDown" onclick="PT_Reduce('pt_3', 1);" />
                        <input type="button" class="btnPTUp" onclick="PT_Increase('pt_3', 1);" />
                        <input type="button" class="btnPTSub" onclick="PT_Reduce('pt_3', 10);" />
                        <input type="button" class="btnPTAdd" onclick="PT_Increase('pt_3', 10);" />
                    </span>
                </td>
                <td class="C">
                    <span class="spanPT">
                        <select id="pt_4" name="pt_4" onchange="PTChanging(this, '')" style="position: relative;">
                        </select>
                        <input type="button" class="btnPTDown" onclick="PT_Reduce('pt_4', 1);" />
                        <input type="button" class="btnPTUp" onclick="PT_Increase('pt_4', 1);" />
                        <input type="button" class="btnPTSub" onclick="PT_Reduce('pt_4', 10);" />
                        <input type="button" class="btnPTAdd" onclick="PT_Increase('pt_4', 10);" />
                    </span>
                </td>
                <td class="noneBorderR">
                    <span class="spanPT">
                        <select id="comm_5" name="comm_5" onchange="PTChanging(this, '')" style="position: relative;">
                        </select>
                        <input type="button" class="btnPTDown" onclick="PT_Reduce('comm_5', 1);" />
                        <input type="button" class="btnPTUp" onclick="PT_Increase('comm_5', 1);" />
                        <input type="button" class="btnPTSub" onclick="PT_Reduce('comm_5', 10);" />
                        <input type="button" class="btnPTAdd" onclick="PT_Increase('comm_5', 10);" />
                    </span>
                </td>
            </tr>            
        </table>
            i++;   
        }    
    </div>
    <div style="text-align: right">
        <input class="buttonPopup btnTop" type="button" value="Submit" data-bind='click: saveCustomer' />
    </div>
    <script type="text/javascript">
        
        
       
    </script>
</div>