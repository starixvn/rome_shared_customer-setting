@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.ViewModels
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model CasinoSettingModel
@{
    //var isPtByGameType = true;// For testing purpose only
    var isPtByGameType = Model.IsPtByGameType;
    //Model.IsPtByGameType = isPtByGameType;// For testing purpose only
    var settingModel = JsonConvert.SerializeObject(Model, Formatting.None, new JsonSerializerSettings
        {
            ContractResolver = new CamelCasePropertyNamesContractResolver(),
            NullValueHandling = NullValueHandling.Ignore
        });    
}
<div id="ng-app" style="display: none; width: 1024px" ng-app="settingApp">
    <div id="errMsg" style="display: none;" class="errMsg">
    </div>
    <div id="arrowUpDown" class="collapse">
    </div>
    <div id="names" style="display: none;" class="names">
    </div>    
    <div>
        <input class="buttonPopup" type="button" value="Submit" />
    </div>
    <div>
        @Html.Action("CustomerInfo", "CasinoCustomer", new { area = string.Empty, id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]), uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]) })
    </div>
    <div>
        <div class="headerPositionTaking" style="border: 1px solid #ccc; border-top: 0">
            Postition Taking
        </div>                                                                                                                                                                                                                                                                                                                                                            
        <div style="border-right: none" id="settingContainer" ng-controller="EditMasterController">
            <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="gameGroupWidth noneBorderL noneBorderTop noneBorderR">&nbsp;</td>
                    <td class="gameTypeWidth noneBorderL noneBorderTop">&nbsp;</td>
                    <td class="ptTitle noneBorderTop tdWidth">Super Preset PT</td>
                    <td class="ptTitle noneBorderTop autoPtWidth">Super Auto PT</td>
                    <td class="ptTitle noneBorderTop tdWidth">Master Max PT</td>
                    <td class="ptTitle noneBorderTop tdWidth">Master Min PT</td>
                    <td class="ptTitle noneBorderTop tdWidth">Master Commission</td>
                </tr>
                <tr ng-controller="GameGroupController" ng-repeat="gameGroup in customer.gameGroups" ng-finish-render="rendered">
                    <td class="gameGroupWidth gameTitle noneBorderTop">{{gameGroup.gameGroupName}}</td>
                    <td colspan="6" class="noneBorderBottom noneBorderTop">
                        <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
                            <tr>                                <td class="gameTypeWidth ptTitle R noneBorderTop noneBorderL">Group Setting</td>                                <td class="C ptTitle noneBorderTop tdWidth">
                                    <span ng-init="gameGroup.l4 = gameGroup.s4 - gameGroup.s3" ng-click="gameGroup.l4 = gameGroup.s4 - gameGroup.s3" enable="gameGroup.is3" class="spanPT" ptarea="true" min="0" max="s4" selected="s3" ng-model="setting"></span>
                                </td>
                                <td class="C ptTitle noneBorderTop autoPtWidth">
                                    <input type="checkbox" ng-model="gameGroup.is3" />
                                    <span enable="gameGroup.is3 == false" class="spanPT" ptarea="true" min="0" max="s4" selected="us3" ng-model="setting"></span>
                                </td>
                                <td class="C ptTitle noneBorderTop tdWidth">
                                    <span ng-init="gameGroup.l4 = gameGroup.s4 - gameGroup.s3" ng-click="gameGroup.l4 = gameGroup.s4 - gameGroup.s3" class="spanPT" ptarea="true" min="0" max="l4" selected="m3" ng-model="setting"></span>
                                </td>
                                <td class="C ptTitle noneBorderTop tdWidth">
                                    <span class="spanPT" ptarea="true" min="0" max="m3" selected="n3" ng-model="setting"></span>
                                </td>
                                <td class="C ptTitle noneBorderTop tdWidth" style="border-right: 0px none">
                                    <span class="spanPT" ptarea="true" min="0" max="sco" selected="mco" ng-model="setting" iscomm = "true"></span>
                                </td>
                            </tr>         
                            @if (isPtByGameType)
                            {                
                            <tr ng-controller="GameTypeController" ng-repeat="gameType in gameGroup.gameTypes" ng-finish-render="rendered">
                                <td colspan="6" style="border: none">
                                    <table class="tableInfo" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <td rowspan="2" class="gameTypeWidth R noneBorderL noneBorderT">
                                                {{gameType.gameTypeName}}
                                            </td>
                                            <td class="C noneBorderT tdWidth">
                                                <span ng-init="gameType.l4 = gameType.s4 - gameType.s3" ng-click="gameType.l4 = gameType.s4 - gameType.s3" enable="gameType.is3" class="spanPT" showbutton="false" ptarea="true" min="0" max="s4" selected="s3" ng-model="setting"></span>
                                            </td>
                                            <td class="C noneBorderT autoPtWidth">
                                                <input type="checkbox" ng-model="gameType.is3" />
                                                    <span enable="gameType.is3 == false" class="spanPT" showbutton="false" ptarea="true" min="0" max="s4" selected="us3" ng-model="setting"></span>
                                            </td>
                                            <td class="C noneBorderT tdWidth">
                                                <span ng-init="gameType.l4 = gameType.s4 - gameType.s3" ng-click="gameType.l4 = gameType.s4 - gameType.s3" class="spanPT" showbutton="false" ptarea="true" min="0" max="l4" selected="m3" ng-model="setting"></span>
                                            </td>
                                            <td class="C noneBorderT tdWidth">
                                                <span class="spanPT" showbutton="false" ptarea="true" min="0" max="m3" selected="n3" ng-model="setting"></span>
                                            </td>
                                            <td class="noneBorderR C noneBorderT noneBorderRight tdWidth">
                                                <span class="spanPT" showbutton="false" ptarea="true" min="0" max="sco" selected="mco" ng-model="setting" iscomm = "true"></span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="5" class="noneBorderRight"><span>Betting Limit: </span>
                                                <span ng-controller="BettingLimitController" ng-repeat="stake in gameType.bettingLimits">
                                                    <input type="checkbox" ng-model="stake.isChecked" /><span>{{stake.stakeLevelName}}</span>
                                                </span>
                                            </td>
                                        </tr>
                                    </table>
                                </td>                    
                            </tr>                
                            }
                            else
                            {
		                    <tr ng-controller="GameTypeController" ng-repeat="gameType in gameGroup.gameTypes" ng-finish-render="rendered">
                                <td class="gameTypeWidth R noneBorderL">
                                    {{gameType.gameTypeName}}
                                </td>
                                <td colspan="5" class="noneBorderR"><span>Betting Limit: </span>
                                    <span ng-controller="BettingLimitController" ng-repeat="stake in gameType.bettingLimits">
                                        <input type="checkbox" ng-model="stake.isChecked" /><span>{{stake.stakeLevelName}}</span>
                                    </span>
                                </td>
                            </tr>
                            }
                        </table>
                    </td>                    
                </tr>                                        
            </table>            
        </div>
    </div>
    <div>
        <input class="buttonPopup" type="button" value="Submit" />
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/EditMasterController.js")" type="text/javascript"></script>
<script type="text/javascript">
    var customerSetting = $.parseJSON(Fanex.CustomerSetting.Core.DecodeHtml('@settingModel'));

    $(document).ready(function () {
        //var casinoController = new CasinoController(userId, username, isMultiple, custIds, usernames);
        var casinoController = new CasinoController(uplineId, '');

        $('.buttonPopup').bind('click', function () {
            casinoController.Update();
        });
    });
</script>