@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.ViewModels
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model CasinoSettingModel
@{
    var i = 0;
    var j = 0;
    //var isPtByGameType = true;// For testing purpose only
    var isPtByGameType = Model.IsPtByGameType;
    //Model.IsPtByGameType = isPtByGameType;// For testing purpose only
    var settingModel = JsonConvert.SerializeObject(Model, new JsonSerializerSettings
        {
            ContractResolver = new CamelCasePropertyNamesContractResolver(),
            NullValueHandling = NullValueHandling.Ignore
        });    
}
<html ng-app>
<head>
    <title>Super Edit Master Casino Setting</title>
    <link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Styles/Casino.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <div id="product" style="width: 1024px">
        <div id="errMsg" style="display: none;" class="errMsg">
        </div>
        <div id="arrowUpDown" class="collapse">
        </div>
        <div id="names" style="display: none;" class="names">
        </div>
        <div style="text-align: right">
            <input class="buttonPopup" type="button" value="Submit" onclick="Fanex.CustomerSetting.Casino.EditMaster.Update()" />
        </div>
        <div id="info">
            @Html.Action("CustomerInfo", "Customer", new { area = string.Empty, id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]), uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]) })
        </div>





    </div>

    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/CustomerSettingController.js")" type="text/javascript"></script>
    @*<script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/Fanex.CustomerSetting.Casino.EditMaster.js")" type="text/javascript"></script>*@
    <script type="text/javascript">
        var model = /*Fanex.CustomerSetting.Casino.EditMaster.SettingModel =*/ $.parseJSON(Fanex.CustomerSetting.Core.DecodeHtml('@settingModel'));

        if (typeof console != 'undefined')
            console.log(model);

        function toUrl(relativeUrl) {
            return '@Url.Content("~/CustomerSetting/Casino/")' + relativeUrl;
        }
    </script>

    <div ng-controller="CustomerSettingController">
        <div class="headerPositionTaking" style="border-bottom: 1px solid #ccc">Postition Taking</div>
        <div ng-repeat="gameSetting in model.gameGroups">
            <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
                <tr>
                    <td style="width: 230px" colspan="2" class="noneBorderL noneBorderTop">
                        &nbsp;
                    </td>
                    <td class="ptTitle noneBorderTop">
                        Super Preset PT
                    </td>
                    <td class="ptTitle noneBorderTop">
                        Super Auto PT
                    </td>
                    <td class="ptTitle noneBorderTop">
                        Master Max PT
                    </td>
                    <td class="ptTitle noneBorderTop">
                        Master Min PT
                    </td>
                    <td class="ptTitle noneBorderR noneBorderTop">
                        Master Commission
                    </td>
                </tr>
                <tr>
                    <td class="gameTitle" style="width: 80px">
                        {{gameSetting.gameGroupName}}
                    </td>
                    <td class="ptTitle R" style="width: 150px">
                        Group Setting
                    </td>
                    <td class="C">
                        <span class="spanPT">
                            <select ng-disabled="is3" min="0" max="{{gameSetting.s4}}" step="0.01" style="position: relative;">
                                <option value="{{gameSetting.s3}}">{{gameSetting.s3}}</option>
                            </select>
                            <input type="button" class="btnPTDown" ng-click="PT_Reduce1(gameSetting,1);" />
                            <input type="button" class="btnPTUp" ng-click="PT_Increase1(gameSetting,1);" />
                            <input type="button" class="btnPTSub" ng-click="PT_Reduce1(gameSetting,10);" />
                            <input type="button" class="btnPTAdd" ng-click="PT_Increase1(gameSetting,10);" />
                        </span>
                    </td>
                    <td class="C">
                        <span class="spanPT">
                            <input ng-model="is3" type="checkbox" name="chkAutoPT" style="vertical-align: middle;" />
                            <select ng-disabled="!is3" min="0" max="{{gameSetting.s4}}" step="0.01" style="position: relative;" >
                                <option value="{{gameSetting.us3}}">{{gameSetting.us3}}</option>
                            </select>
                            <input type="button" class="btnPTDown" ng-click="PT_Reduce1(gameSetting,1);" />
                            <input type="button" class="btnPTUp" ng-click="PT_Increase1(gameSetting,1);" />
                            <input type="button" class="btnPTSub" ng-click="PT_Reduce1(gameSetting,10);" />
                            <input type="button" class="btnPTAdd" ng-click="PT_Increase1(gameSetting,10);" />
                        </span>
                    </td>
                </tr>
            </table>
        </div>
    </div>

</body>
</html>
