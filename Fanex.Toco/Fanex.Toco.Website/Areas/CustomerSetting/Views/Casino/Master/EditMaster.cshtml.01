@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.ViewModels
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model CasinoSettingModel
@{
    var i = 0;
    var j = 0;
    //var isPtByGameType = true;// For testing purpose only
    var isPtByGameType = Model.IsPtByGameType;
    //Model.IsPtByGameType = isPtByGameType;// For testing purpose only
    var settingModel = JsonConvert.SerializeObject(Model, new JsonSerializerSettings
        {
            ContractResolver = new CamelCasePropertyNamesContractResolver(),
            NullValueHandling = NullValueHandling.Ignore
        });    
}
<div id="product" style="width: 1024px">
    <div id="errMsg" style="display: none;" class="errMsg">
    </div>
    <div id="arrowUpDown" class="collapse">
    </div>
    <div id="names" style="display: none;" class="names">
    </div>
    <div style="text-align: right">
        <input class="buttonPopup" type="button" value="Submit" onclick = "Fanex.CustomerSetting.Casino.EditMaster.Update()" />
    </div>
    <div id="info">
        @Html.Action("CustomerInfo", "Customer", new { area = string.Empty, id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]), uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]) })
    </div>    
        <div id="settingContainer">    
        <div class="headerPositionTaking" style="border-bottom: 1px solid #ccc">
        Postition Taking</div>
        @foreach (var gameSetting in Model.GameGroups)
        {
            var rowSpan = isPtByGameType ? gameSetting.GameTypes.Count * 2 + 1 : gameSetting.GameTypes.Count + 1;
            var gameTypes = gameSetting.GameTypes;
            var isAuto = gameSetting.Is3 == true ? "checked=\"checked\"" : string.Empty;
            var disabled = gameSetting.Is3 == true ? "disabled=\"disabled\"" : string.Empty;
            var disabledIsAuto = gameSetting.Is3 == false ? "disabled=\"disabled\"" : string.Empty;
            var maxPtMaster = gameSetting.S4 - gameSetting.S3;
            
        <table id="casinoGame_@i" class="tableInfo" border="1" cellpadding="0" cellspacing="0">
            <tr>
                <td style="width: 230px" colspan="2" class="noneBorderL noneBorderTop">&nbsp;</td>
                <td class="ptTitle noneBorderTop">Super Preset PT</td>
                <td class="ptTitle noneBorderTop">Super Auto PT</td>
                <td class="ptTitle noneBorderTop">Master Max PT</td>
                <td class="ptTitle noneBorderTop">Master Min PT</td>
                <td class="ptTitle noneBorderR noneBorderTop">Master Commission</td>
            </tr>
            <tr>
                <td id="rowspanCasino_@i" rowspan="@rowSpan" class="gameTitle" style="width: 80px">@gameSetting.GameGroupName</td>                
                <td class="ptTitle R" style="width: 150px">Group Setting</td>
                <td class="C">
                    <span class="spanPT">
                        <select min = "0" max = "@gameSetting.S4" step="0.01" @disabled id="pt_1_@i" name="pt_1_@i"  style="position: relative;">
                            <option value="@gameSetting.S3">@gameSetting.S3</option>
                        </select>
                        <input type="button" class="btnPTDown" onclick="PT_Reduce('pt_1_@i', 1);" />
                        <input type="button" class="btnPTUp" onclick="PT_Increase('pt_1_@i', 1);" />
                        <input type="button" class="btnPTSub" onclick="PT_Reduce('pt_1_@i', 10);" />
                        <input type="button" class="btnPTAdd" onclick="PT_Increase('pt_1_@i', 10);" />
                    </span>
                </td>
                <td class="C">
                    <span class="spanPT">
                        <input @isAuto type="checkbox" name="chkAutoPT" id="chkAutoPT_@i" style="vertical-align: middle;" />
                        <select min = "0" max = "@gameSetting.S4" step="0.01" @disabledIsAuto id="pt_2_@i" name="pt_2_@i" style="position: relative;" >
                            <option value="@gameSetting.Us3">@gameSetting.Us3</option>
                        </select>
                        <input type="button" class="btnPTDown" onclick="PT_Reduce('pt_2_@i', 1);" />
                        <input type="button" class="btnPTUp" onclick="PT_Increase('pt_2_@i', 1);" />
                        <input type="button" class="btnPTSub" onclick="PT_Reduce('pt_2_@i', 10);" />
                        <input type="button" class="btnPTAdd" onclick="PT_Increase('pt_2_@i', 10);" />
                    </span>
                </td>
                <td class="C">
                    <span class="spanPT">
                        <select min = "0" max = "@maxPtMaster" step="0.01" id="pt_3_@i" name="pt_3_@i"  style="position: relative;">
                            <option value="@gameSetting.M3">@gameSetting.M3</option>
                        </select>
                        <input type="button" class="btnPTDown" onclick="PT_Reduce('pt_3_@i', 1);" />
                        <input type="button" class="btnPTUp" onclick="PT_Increase('pt_3_@i', 1);" />
                        <input type="button" class="btnPTSub" onclick="PT_Reduce('pt_3_@i', 10);" />
                        <input type="button" class="btnPTAdd" onclick="PT_Increase('pt_3_@i', 10);" />
                    </span>
                </td>
                <td class="C">
                    <span class="spanPT">
                        <select min = "0" max = "@maxPtMaster" step="0.01" id="pt_4_@i" name="pt_4_@i"  style="position: relative;">
                            <option value="@gameSetting.N3">@gameSetting.N3</option>
                        </select>
                        <input type="button" class="btnPTDown" onclick="PT_Reduce('pt_4_@i', 1);" />
                        <input type="button" class="btnPTUp" onclick="PT_Increase('pt_4_@i', 1);" />
                        <input type="button" class="btnPTSub" onclick="PT_Reduce('pt_4_@i', 10);" />
                        <input type="button" class="btnPTAdd" onclick="PT_Increase('pt_4_@i', 10);" />
                    </span>
                </td>
                <td class="noneBorderR C">
                    <span class="spanPT">
                        <select min = "0" max = "@gameSetting.Sco" step="0.0005" id="comm_5_@i" name="comm_5_@i"  style="position: relative;">
                            <option value="@gameSetting.Mco">@gameSetting.Mco</option>
                        </select>
                        <input type="button" class="btnPTDown" onclick="PT_Reduce('comm_5_@i', 1);" />
                        <input type="button" class="btnPTUp" onclick="PT_Increase('comm_5_@i', 1);" />
                        <input type="button" class="btnPTSub" onclick="PT_Reduce('comm_5_@i', 10);" />
                        <input type="button" class="btnPTAdd" onclick="PT_Increase('comm_5_@i', 10);" />
                    </span>
                </td>
            </tr>
        @foreach (var gameType in gameTypes)
        {
            var stakes = gameType.BettingLimits;
            var subid = i + "_" + j;
            isAuto = gameType.Is3 == true ? "checked=\"checked\"" : string.Empty;
            disabled = gameType.Is3 == true ? "disabled=\"disabled\"" : string.Empty;
            disabledIsAuto = gameType.Is3 == false ? "disabled=\"disabled\"" : string.Empty;
            maxPtMaster = gameType.S4 - gameType.S3;
                        
            if (isPtByGameType)
            {
            <tr>
                <td rowspan="2" class="R">
                    @gameType.GameTypeName
                </td>
                <td class="C">
                    <span class="spanPT">
                        <select min = "0" max = "@gameType.S4" step="0.01" @disabled id="pt_1_@subid" name="pt_1_@subid" style="position: relative;">
                            <option value="@gameType.S3">@gameType.S3</option>
                        </select>
                    </span><span id="lbl_pt_1_@subid" class="hideWarningPT">*</span>
                </td>
                <td class="C">
                    <span class="spanPT">
                        <input @isAuto type="checkbox" name="chkAutoPT" id="chkAutoPT_@subid" style="vertical-align: middle;" />
                        <select min = "0" max = "@gameType.S4" step="0.01" @disabledIsAuto id="pt_2_@subid" name="pt_2_@subid" style="position: relative;" >
                            <option value="@gameType.Us3">@gameType.Us3</option>
                        </select>
                    </span><span id="lbl_pt_2_@subid" class="hideWarningPT">*</span>
                </td>
                <td class="C">
                    <span class="spanPT">
                        <select min = "0" max = "@maxPtMaster" step="0.01" id="pt_3_@subid" name="pt_3_@subid" style="position: relative;">
                            <option value="@gameType.M3">@gameType.M3</option>
                        </select>
                    </span><span id="lbl_pt_3_@subid" class="hideWarningPT">*</span>
                </td>
                <td class="C">
                    <span class="spanPT">
                        <select min = "0" max = "@maxPtMaster" step="0.01" id="pt_4_@subid" name="pt_4_@subid" style="position: relative;">
                            <option value="@gameType.N3">@gameType.N3</option>
                        </select>
                    </span><span id="lbl_pt_4_@subid" class="hideWarningPT">*</span>
                </td>
                <td class="noneBorderR C">
                    <span class="spanPT">
                        <select min = "0" max = "@gameType.Sco" step="0.0005" id="comm_5_@subid" name="comm_5_@subid" style="position: relative;">
                            <option value="@gameType.Mco">@gameType.Mco</option>
                        </select>
                    </span><span id="lbl_comm_5_@subid" class="hideWarningPT">*</span>
                </td>                
            </tr>
            <tr>
                <td colspan="5" class="noneBorderR"><span>Betting Limit: </span>
                    @foreach (var stake in stakes)
                    {
                        var isChecked = stake.IsChecked ? "checked=\"checked\"" : string.Empty;
                        
                        <input id="stake-@stake.StakeLevelID" type="checkbox" @isChecked /><span>@stake.StakeLevelName</span>
                    }
                </td>                
            </tr>
            }
            else
            {
		    <tr>
                <td class="R">
                    @gameType.GameTypeName
                </td>
                <td colspan="5" class="noneBorderR"><span>Betting Limit: </span>
                    @foreach (var stake in stakes)
                    {
                        var isChecked = stake.IsChecked ? "checked=\"checked\"" : string.Empty;
                        
                        <input id="stake-@stake.StakeLevelID" type="checkbox" @isChecked /><span>@stake.StakeLevelName</span>
                    }
                </td>
            </tr>
            }
            j++;
        }            
        </table>
        i++;
        j = 0;
        }    
        </div>        
    <div style="text-align: right">
        <input class="buttonPopup btnTop" type="button" value="Submit" onclick = "Fanex.CustomerSetting.Casino.EditMaster.Update()" />
    </div>
</div>    
<script src="@BundleTable.Bundles.ResolveBundleUrl("~/master/js")" type="text/javascript"></script>
<script type="text/javascript">
    var model = Fanex.CustomerSetting.Casino.EditMaster.SettingModel = $.parseJSON(Fanex.CustomerSetting.Core.DecodeHtml('@settingModel'));

    if (typeof console != 'undefined')
        console.log(model);

    function toUrl(relativeUrl){
        return '@Url.Content("~/CustomerSetting/Casino/")' + relativeUrl;
    }
</script>