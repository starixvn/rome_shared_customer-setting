@model dynamic

@{
    ViewBag.Title = "title";
    Layout = "~/Areas/CustomerSetting/Views/Shared/_Layout.cshtml";
}

<div id="product">
<div id="errMsg" style="display: none;" class="errMsg">
</div>
<div id="arrowUpDown" class="collapse">
</div>
<div id="names" style="display: none;" class="names">
</div>
<div style="text-align: right">
    <input class="buttonPopup btnTop" type="button" value="Submit" data-bind='click: saveCustomer' />
</div>
<div style="border: 1px solid #ccc; border-bottom: none">
    <div class="headerPositionTaking noneBorderLR" style="border-bottom: 0;">
        General Information</div>
    <div id="custInfo">
    <table border="1" cellpadding="1" cellspacing="2" class="tableInfo">
        <tr>
            <td class="tdTitleLeft">Username</td>
            <td style="width: 35%"><span data-bind="text: Fanex.ExtAcc.Customer.Casino.customer.customerInfo.userName"></span></td>
            <td class="tdTitleRight">Nickname</td>
            <td style="border-right: none"><span data-bind="text: Fanex.ExtAcc.Customer.Casino.customer.customerInfo.userName2"></span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">First Name</td>
            <td><span data-bind="text: Fanex.ExtAcc.Customer.Casino.customer.customerInfo.firstName"></span></td>
            <td class="tdTitleRight">Phone</td>
            <td style="border-right: none"><span data-bind="text: Fanex.ExtAcc.Customer.Casino.customer.customerInfo.phone"></span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">Last Name</td>
            <td><span data-bind="text: Fanex.ExtAcc.Customer.Casino.customer.customerInfo.lastName"></span></td>
            <td class="tdTitleRight">Mobile Phone</td>
            <td style="border-right: none"><span data-bind="text: Fanex.ExtAcc.Customer.Casino.customer.customerInfo.mobilePhone"></span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">Fax</td>
            <td><span data-bind="text: Fanex.ExtAcc.Customer.Casino.customer.customerInfo.fax"></span></td>
            <td class="tdTitleRight">Enable Casino</td>
            <td style="border-right: none">                
                <div style="float: left; height: 24px">
                    <input type="checkbox" id="chkEnable" data-bind="checked: !Fanex.ExtAcc.Customer.Casino.customer.customerInfo.casinoDisabled && Fanex.ExtAcc.Customer.Casino.customer.customerInfo.casinoSync" style="margin-top: 5px" />                    
                    <label for="chkEnable" id="downline"></label>
                    <input type="checkbox" id="chkEnableDownline" data-bind="checked: !Fanex.ExtAcc.Customer.Casino.customer.customerInfo.casinoDisabled && Fanex.ExtAcc.Customer.Casino.customer.customerInfo.casinoSync" style="margin-top: 5px" />                    
                    <label for="chkEnableDownline" id="enableDownlineText">Previous enabled downlines</label>
                </div>                
            </td>
        </tr>         
    </table>
    </div>
    <div id="statusInfo" class="statusInfo">Enable Casino:
        <span style="font-weight: normal; margin-right: 5px">
            <input type="checkbox" id="chkEnable" data-bind="checked: !Fanex.ExtAcc.Customer.Casino.customer.customerInfo.casinoDisabled && Fanex.ExtAcc.Customer.Casino.customer.customerInfo.casinoSync" style="margin-top: 5px" />
            <label for="chkEnable" id="downline"></label>
        </span>
        <span>
            <input type="checkbox" id="chkEnableDownline" data-bind="checked: !Fanex.ExtAcc.Customer.Casino.customer.customerInfo.casinoDisabled && Fanex.ExtAcc.Customer.Casino.customer.customerInfo.casinoSync" style="margin-top: 5px" />
            <label for="chkEnableDownline" id="enableDownlineText">Previous enabled downlines</label>
        </span>
