@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.Entities
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model CasinoCustomer
@{
    var customer = JsonConvert.SerializeObject(Model, new JsonSerializerSettings
    {
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });
    
    var id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Styles/Casino.css")" rel="stylesheet" type="text/css" />
<div class="custInfo" ng-controller="CustomerController">
    <div class="headerPositionTaking noneBorderLR custInfoHeader">
        General Information</div>
    <div id="userInfo">
    <table cellpadding="0" cellspacing="0" class="tableInfo">
        <tr>
            <td class="tdTitleLeft">Username</td>
            <td style="width: 35%"><span>{{CustomerModel.userName}}</span></td>
            <td class="tdTitleRight">Nickname</td>
            <td class="noneBorderRight"><span>{{CustomerModel.userName2}}</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">First Name</td>
            <td><span>{{CustomerModel.firstName}}</span></td>
            <td class="tdTitleRight">Phone</td>
            <td class="noneBorderRight"><span>{{CustomerModel.phone}}</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">Last Name</td>
            <td><span>{{CustomerModel.lastName}}</span></td>
            <td class="tdTitleRight">Mobile Phone</td>
            <td class="noneBorderRight"><span>{{CustomerModel.mobilePhone}}</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">Fax</td>
            <td><span>{{CustomerModel.fax}}</span></td>
            <td class="tdTitleRight">Enable Casino</td>
            <td class="noneBorderRight">                
                <div style="float: left; height: 24px">
                    <input type="checkbox" id="chkEnable" ng-click="EnableClicked()" style="margin-top: 5px" ng-init="CustomerModel.casinoEnabled = !CustomerModel.casinoDisabled" ng-model="CustomerModel.casinoEnabled" ng-change="CustomerModel.casinoDisabled = !CustomerModel.casinoEnabled; CustomerModel.showDownline = !Enabled && CustomerModel.casinoEnabled;" ng-disabled="CustomerModel.uplineDisabledCasino"/>                    
                    <label for="chkEnable" id="downline"></label>                    
                    <span ng-init="CustomerModel.showDownline = !Enabled && CustomerModel.casinoEnabled" ng-model="CustomerModel.showDownline" ng-show="CustomerModel.showDownline">
                        <input type="checkbox" id="chkEnableDownline" ng-model="CustomerModel.enableDownline" ng-show="CustomerModel.showDownline" style="margin-top: 5px;" />                    
                        <label for="chkEnableDownline" id="enableDownlineText" ng-model="CustomerModel.showDownline" ng-show="CustomerModel.showDownline">Previous enabled downlines</label>
                    </span>
                </div>                
            </td>
        </tr>         
    </table>
    </div>
    <div id="statusInfo" class="statusInfo"><span class="tdTitleRight">Enable Casino:</span>
        <span style="height: 24px">
            <input type="checkbox" id="chkEnable" ng-click="EnableClicked()" style="margin-top: 5px" ng-init="CustomerModel.casinoEnabled = !CustomerModel.casinoDisabled" ng-model="CustomerModel.casinoEnabled" ng-change="CustomerModel.casinoDisabled = !CustomerModel.casinoEnabled; CustomerModel.showDownline = !Enabled && CustomerModel.casinoEnabled;" ng-disabled="CustomerModel.uplineDisabledCasino"/>                    
            <label for="chkEnable" id="downline"></label>                    
            <span ng-init="CustomerModel.showDownline = !Enabled && CustomerModel.casinoEnabled" ng-model="CustomerModel.showDownline" ng-show="CustomerModel.showDownline">
                <input type="checkbox" id="chkEnableDownline" ng-model="CustomerModel.enableDownline" ng-show="CustomerModel.showDownline" style="margin-top: 5px;" />                    
                <label for="chkEnableDownline" id="enableDownlineText" ng-model="CustomerModel.showDownline" ng-show="CustomerModel.showDownline">Previous enabled downlines</label>
            </span>
        </span>                
    </div>
    <div class="headerPositionTaking noneBorderLR noneBorderBottom">
        Bet Setting</div>
    <table cellpadding="0" cellspacing="0" class="tableInfo">
        <tr>
            <td style="width: 40%" class="noneBorderLeft tdTitleRight">Accumulated transferable amount</td>
            <td class="noneBorderRight"><span style="margin-left: 4px">@Utils.ToStringFormat(@Model.TotalWinLoss)</span></td>
        </tr>
        <tr>
            <td class="noneBorderLeft tdTitleRight">Member Max Transfer Credit</td>
            <td class="noneBorderRight">
                <div style="float: left; height: 24px"><input id="maxTransfer" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" type="text" ng-model="CustomerModel.maxTransferCredit" /></div>
                <div style="float: left; height: 24px;"><input id="isAutoReset" type="checkbox" ng-model="CustomerModel.isAutoReset" /><label for="isAutoReset">Daily auto reset limit (at 12 noon GMT+8)</label></div>
            </td>           
        </tr>
        <tr>
            <td class="noneBorderLeft"></td>
            <td class="noneBorderRight">(<span id="minCredit">@Utils.ToStringFormat(@Model.MinTransferCreditLimit)</span>&nbsp;-&nbsp;<span id="maxCredit">@Utils.ToStringFormat(@Model.MaxTransferCreditLimit)</span>)</td>                    
        </tr>
    </table>    
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/ptarea.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/CustomerController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/CasinoController.js")" type="text/javascript"></script>   
     <script type="text/javascript">
        var customerModel = $.parseJSON(Fanex.CustomerSetting.Core.DecodeHtml('@customer'));
        var custId = '@id';
        var uplineId = '@uplineId';

        function toUrl(relativeUrl) {
            return '@Url.Content("~/CustomerSetting/Casino/")' + relativeUrl;
        }
    </script>
</div>
