@using Fanex.ExternalAccount.Utilities
@model Fanex.ExternalAccount.DTO.Customer.Casino.CasinoCustomer
@{
    var check = Model.IsAutoReset ? " checked=\"checked=\"" : string.Empty;
    var enable = !Model.CasinoDisabled && Model.CasinoSync ? " checked=\"checked\"" : string.Empty;
}
<div id="custInfo">
    <div class="headerPositionTaking noneBorderLR" style="border-bottom: 0; border-top: 1px solid #ccc">
        General Information</div>
    <table border="1" cellpadding="0" cellspacing="0" class="tableInfo">
        <tr>
            <td class="tdTitleLeft">Username</td>
            <td style="width: 35%"><span>@Model.UserName</span></td>
            <td class="tdTitleRight">Nickname</td>
            <td style="border-right: none"><span>@Model.UserName2</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">First Name</td>
            <td><span>@Model.FirstName</span></td>
            <td class="tdTitleRight">Phone</td>
            <td style="border-right: none"><span>@Model.Phone</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">Last Name</td>
            <td><span>@Model.LastName</span></td>
            <td class="tdTitleRight">Mobile Phone</td>
            <td style="border-right: none"><span>@Model.LastName</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">Fax</td>
            <td><span>@Model.LastName</span></td>
            <td class="tdTitleRight">Enable Casino</td>
            <td style="border-right: none">                
                <div style="float: left; height: 24px">
                    <input type="checkbox" id="chkEnable" style="margin-top: 5px" @enable/>                    
                    <label for="chkEnable" id="downline">Master</label>
                    @if (Model.CasinoDisabled && @Model.CasinoSync)
                    {
                    <input type="checkbox" id="chkEnableDownline" @enable style="margin-top: 5px" />                    
                    <label for="chkEnableDownline" id="enableDownlineText">Previous enabled downlines</label>
                    }
                </div>                
            </td>
        </tr>         
    </table>
    <div style="border-bottom: none" class="headerPositionTaking noneBorderLR">
        Bet Setting</div>
    <table border="1" cellpadding="0" cellspacing="0" class="tableInfo">
        <tr>
            <td style="border-left: none; width: 40%" class="tdTitleRight">Accumulated transferable amount</td>
            <td style="width: 60%; border-right: none"><span style="margin-left: 5px">@Utils.ToStringFormat(@Model.TotalWinLoss)</span></td>
        </tr>
        <tr>
            <td style="border-left: none" class="tdTitleRight">Member Max Transfer Credit</td>
            <td style="border-right: none">
                <div style="float: left; height: 24px"><input id="maxTransfer" style="height: 20px !important" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" type="text" value="@Utils.ToStringFormat(@Model.MaxTransferCredit, 2)" /></div>
                <div style="float: left; height: 24px;"><input style="margin-top: 5px" id="isAutoReset" type="checkbox" @check /><label for="isAutoReset">Daily auto reset limit (at 12 noon GMT+8)</label></div>
            </td>           
        </tr>
        <tr>
            <td style="border-left: none"></td>
            <td style="border-right: none">(<span id="minCredit">@Utils.ToStringFormat(@Model.MinTransferCreditLimit)</span>&nbsp;-&nbsp;<span id="maxCredit">@Utils.ToStringFormat(@Model.MaxTransferCreditLimit)</span>)</td>                    
        </tr>
    </table>
</div>