@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.Entities
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model CasinoCustomer
@{
    var check = Model.IsAutoReset ? " checked=\"checked=\"" : string.Empty;
    var enable = !Model.CasinoDisabled && Model.CasinoSync ? " checked=\"checked\"" : string.Empty;
    var disable = Model.UplineDisabledCasino && Model.CasinoDisabled && Model.CasinoSync ? " disabled=\"disabled\"" : string.Empty;
    var customer = JsonConvert.SerializeObject(Model, new JsonSerializerSettings
    {
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });     
}
<link href="@BundleTable.Bundles.ResolveBundleUrl("~/common/css")" rel="stylesheet" type="text/css" />
<div id="custInfo">
    <div class="headerPositionTaking noneBorderLR custInfoHeader">
        General Information</div>
    <div id="userInfo">
    <table cellpadding="0" cellspacing="0" class="tableInfo">
        <tr>
            <td class="tdTitleLeft">Username</td>
            <td style="width: 35%"><span>@Model.UserName</span></td>
            <td class="tdTitleRight">Nickname</td>
            <td class="noneBorderRight"><span>@Model.UserName2</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">First Name</td>
            <td><span>@Model.FirstName</span></td>
            <td class="tdTitleRight">Phone</td>
            <td class="noneBorderRight"><span>@Model.Phone</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">Last Name</td>
            <td><span>@Model.LastName</span></td>
            <td class="tdTitleRight">Mobile Phone</td>
            <td class="noneBorderRight"><span>@Model.LastName</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">Fax</td>
            <td><span>@Model.LastName</span></td>
            <td class="tdTitleRight">Enable Casino</td>
            <td class="noneBorderRight">                
                <div style="float: left; height: 24px">
                    <input type="checkbox" id="chkEnable" style="margin-top: 5px" @enable @disable/>                    
                    <label for="chkEnable" id="downline">Master</label>
                    @if (Model.CasinoDisabled && @Model.CasinoSync)
                    {
                    <input type="checkbox" id="chkEnableDownline" @enable style="margin-top: 5px; display: none" />                    
                    <label for="chkEnableDownline" id="enableDownlineText" style="display: none">Previous enabled downlines</label>
                    }
                </div>                
            </td>
        </tr>         
    </table>
    </div>
    <div id="statusInfo" class="statusInfo"><span class="tdTitleRight">Enable Casino:</span>
        <span style="font-weight: normal; margin-right: 5px">
            <input type="checkbox" id="chkEnable" style="margin-top: 5px" @enable/>                    
            <label for="chkEnable" id="downline">Master</label>
        </span>
        <span>
        @if (Model.CasinoDisabled && @Model.CasinoSync)
        {
        <input type="checkbox" id="chkEnableDownline" @enable style="margin-top: 5px; display: none" />                    
        <label for="chkEnableDownline" id="enableDownlineText" style="display: none">Previous enabled downlines</label>
        }
        </span>
    </div>
    <div class="headerPositionTaking noneBorderLR noneBorderBottom">
        Bet Setting</div>
    <table cellpadding="0" cellspacing="0" class="tableInfo">
        <tr>
            <td style="width: 40%" class="noneBorderLeft tdTitleRight">Accumulated transferable amount</td>
            <td class="noneBorderRight"><span style="margin-left: 4px">@Utils.ToStringFormat(@Model.TotalWinLoss)</span></td>
        </tr>
        <tr>
            <td class="noneBorderLeft tdTitleRight">Member Max Transfer Credit</td>
            <td class="noneBorderRight">
                <div style="float: left; height: 24px"><input id="maxTransfer" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" type="text" value="@Utils.ToStringFormat(@Model.MaxTransferCredit, 2)" /></div>
                <div style="float: left; height: 24px;"><input id="isAutoReset" type="checkbox" @check /><label for="isAutoReset">Daily auto reset limit (at 12 noon GMT+8)</label></div>
            </td>           
        </tr>
        <tr>
            <td class="noneBorderLeft"></td>
            <td class="noneBorderRight">(<span id="minCredit">@Utils.ToStringFormat(@Model.MinTransferCreditLimit)</span>&nbsp;-&nbsp;<span id="maxCredit">@Utils.ToStringFormat(@Model.MaxTransferCreditLimit)</span>)</td>                    
        </tr>
    </table>
</div>
@if (Request.RequestContext.HttpContext.IsDebuggingEnabled)
{
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/Fanex.CustomerSetting.Casino.js")" type="text/javascript"></script>
}
else
{
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/common/js")" type="text/javascript"></script>
}
<script type="text/javascript">
    var customerInfo = Fanex.CustomerSetting.Casino.CustomerModel = $.parseJSON(Fanex.CustomerSetting.Core.DecodeHtml('@customer'));
    if(typeof console != 'undefined'){
        console.log(customerInfo);
    }
</script>