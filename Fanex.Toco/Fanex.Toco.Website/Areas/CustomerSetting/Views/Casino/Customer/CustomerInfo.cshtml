@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.Entities
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using Fanex.CustomerSetting.Module.Casino.Resources
@{    
    var id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Styles/Casino.css")" rel="stylesheet" type="text/css" />
<div class="custInfo" data-ng-controller="CustomerController">
    <div class="headerPositionTaking noneBorderLR custInfoHeader">
        @NGCasinoLang.lblCustomerInformation</div>
    <div id="userInfo">
    <table cellpadding="0" cellspacing="0" class="tableInfo">
        <tr>
            <td class="tdTitleLeft">@NGCasinoLang.lblUsername</td>
            <td style="width: 35%"><span>{{CustomerModel.userName}}</span></td>
            <td class="tdTitleRight">@NGCasinoLang.lblNickname</td>
            <td class="noneBorderRight"><span>{{CustomerModel.userName2}}</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">@NGCasinoLang.lblFirstName</td>
            <td><span>{{CustomerModel.firstName.decodeHtml()}}</span></td>
            <td class="tdTitleRight">@NGCasinoLang.lblPhone</td>
            <td class="noneBorderRight"><span>{{CustomerModel.phone.decodeHtml()}}</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">@NGCasinoLang.lblLastName</td>
            <td><span>{{CustomerModel.lastName.decodeHtml()}}</span></td>
            <td class="tdTitleRight">@NGCasinoLang.lblMobilePhone</td>
            <td class="noneBorderRight"><span>{{CustomerModel.mobilePhone.decodeHtml()}}</span></td>
        </tr>
        <tr>
            <td class="tdTitleLeft">@NGCasinoLang.lblFax</td>
            <td><span>{{CustomerModel.fax.decodeHtml()}}</span></td>
            <td class="tdTitleRight">@NGCasinoLang.lblEnable</td>
            <td class="noneBorderRight">                
                <div style="float: left; height: 24px">
                    <input type="checkbox" id="chkEnable" data-ng-click="EnableClicked()" style="margin-top: 5px" data-ng-init="CustomerModel.casinoEnabled = !CustomerModel.casinoDisabled && CustomerModel.casinoSync" data-ng-model="CustomerModel.casinoEnabled" data-ng-change="CustomerModel.casinoDisabled = !CustomerModel.casinoEnabled; CustomerModel.showDownline = !Enabled && CustomerModel.casinoEnabled;" data-ng-disabled="CustomerModel.uplineDisabledCasino"/>                    
                    <label for="chkEnable" id="downline"></label>                    
                    <span data-ng-init="CustomerModel.showDownline = !Enabled && CustomerModel.casinoEnabled" data-ng-model="CustomerModel.showDownline" data-ng-show="CustomerModel.showDownline && CustomerModel.roleId != 1">
                        <input type="checkbox" id="chkEnableDownline" data-ng-model="CustomerModel.enableDownline" data-ng-show="CustomerModel.showDownline" style="margin-top: 5px;" />                    
                        <label for="chkEnableDownline" id="enableDownlineText" data-ng-model="CustomerModel.showDownline" data-ng-show="CustomerModel.showDownline">Previous enabled downlines</label>
                    </span>
                </div>                
            </td>
        </tr>         
    </table>
    </div>
    <div id="statusInfo" class="statusInfo"><span class="tdTitleRight">@NGCasinoLang.lblEnable:</span>
        <span style="height: 24px">
            <input type="checkbox" id="chkEnable" data-ng-click="EnableClicked()" style="margin-top: 5px" data-ng-init="CustomerModel.casinoEnabled = !CustomerModel.casinoDisabled && CustomerModel.casinoSync" data-ng-model="CustomerModel.casinoEnabled" data-ng-change="CustomerModel.casinoDisabled = !CustomerModel.casinoEnabled; CustomerModel.showDownline = !Enabled && CustomerModel.casinoEnabled;" data-ng-disabled="CustomerModel.uplineDisabledCasino"/>                    
            <label for="chkEnable" id="downline"></label>                    
            <span data-ng-init="CustomerModel.showDownline = !Enabled && CustomerModel.casinoEnabled" data-ng-model="CustomerModel.showDownline" data-ng-show="CustomerModel.showDownline">
                <input type="checkbox" id="chkEnableDownline" data-ng-model="CustomerModel.enableDownline" data-ng-show="CustomerModel.showDownline" style="margin-top: 5px;" />                    
                <label for="chkEnableDownline" id="enableDownlineText" data-ng-model="CustomerModel.showDownline" data-ng-show="CustomerModel.showDownline">@NGCasinoLang.casinodownlines</label>
            </span>
        </span>                
    </div>
    <div class="headerPositionTaking noneBorderLR noneBorderBottom">
        @NGCasinoLang.lblMemberWinLimit</div>
    <table cellpadding="0" cellspacing="0" class="tableInfo">
        <tr>
            <td style="width: 30%" class="noneBorderLeft tdTitleRight">@NGCasinoLang.lblMaximumWin</td>
            <td style="width: 20%"><div>
                <select id="maxWinLimit" style="width: 80px !important" data-ng-model="CustomerModel.memberWinLimit.maximumWin" data-ng-options="opt.key for opt in CustomerModel.memberWinLimit.maximumWinLimits track by opt.value">
                </select>&nbsp;@NGCasinoLang.lblOnGivenCredit</div></td>
            <td class="noneBorderRight" rowspan="{{CustomerModel.roleId != 1 ? 3 : 4}}"><div><label><input type="checkbox" data-ng-disabled="CustomerModel.memberWinLimit.isDailyAutoResetUpline == false && CustomerModel.roleId != 4" data-ng-model="CustomerModel.memberWinLimit.isDailyAutoReset" />@NGCasinoLang.lblDailyAutoResetLimit</label></div></td>
        </tr>
        <tr data-ng-hide="CustomerModel.roleId != 1">
            <td class="noneBorderLeft tdTitleRight">@NGCasinoLang.lblCurrentWinLimit</td>
            <td class=""><span id="currentWinLimit" style="color: #0000ff; cursor: pointer" data-ng-click="GetCurrentWinLimit()">@NGCasinoLang.lblClickToViewCurrentWinLimit</span></td>
        </tr>
        <tr>
            <td class="noneBorderLeft tdTitleRight">@NGCasinoLang.lblMaxLoss</td>
            <td><div>
                <input id="maxTransfer1" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" type="text" data-ng-change="CustomerModel.memberWinLimit.maximumLoss = CustomerModel.memberWinLimit.maximumLossFormated" data-ng-model="CustomerModel.memberWinLimit.maximumLossFormated" />
                </div>
                </td>
        </tr>
        <tr>
            <td class="noneBorderLeft tdTitleRight"></td>
            <td><div>(<span id="minCredit1">{{CustomerModel.memberWinLimit.minimumLoss.formatNumber()}}</span>&nbsp;-&nbsp;<span id="maxCredit1">{{CustomerModel.memberWinLimit.maximumLossLimit == 0 && CustomerModel.roleId == 4 ? '@NGCasinoLang.noLimited' : CustomerModel.memberWinLimit.maximumLossLimit.formatNumber()}}</span>)</div></td>
        </tr>
    </table>
    <div data-ng-hide="true" class="headerPositionTaking noneBorderLR noneBorderBottom">
        @NGCasinoLang.BetSetting</div>
    <table data-ng-hide="true" cellpadding="0" cellspacing="0" class="tableInfo">
        <tr>
            <td style="width: 35%" class="noneBorderLeft tdTitleRight">@NGCasinoLang.lblAccumulatedWinLoss</td>
            <td class="noneBorderRight"><span style="margin-left: 4px; float: left; width: 130px">{{CustomerModel.totalWinLoss.formatNumber()}}</span>
                <div data-ng-hide="CustomerModel.roleId == 4 || CustomerModel.totalWinLoss == 0 || (CustomerModel.uplineRoleId == 4 && CustomerModel.roleId == 2) || !CustomerModel.casinoSync" style="float: left; color: #0066CC; cursor: pointer" data-ng-click="Reset()">@NGCasinoLang.reset</div>
            </td>
        </tr>
        <tr>
            <td class="noneBorderLeft tdTitleRight">@NGCasinoLang.lblMaxTransferCredit</td>
            <td class="noneBorderRight">
                <div style="float: left; height: 24px"><input id="maxTransfer" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" type="text" data-ng-init="CustomerModel.maxTransferFormated" data-ng-change="CustomerModel.maxTransferCredit = CustomerModel.maxTransferFormated" data-ng-model="CustomerModel.maxTransferFormated" /></div>
                <div style="float: left; height: 24px;"><input id="isAutoReset" type="checkbox" data-ng-model="CustomerModel.isAutoReset" /><label for="isAutoReset">@NGCasinoLang.lblDailyAutoResetLimit</label></div>
            </td>           
        </tr>
        <tr>
            <td class="noneBorderLeft"></td>
            <td class="noneBorderRight">(<span id="minCredit">{{CustomerModel.minTransferCreditLimit.formatNumber()}}</span>&nbsp;-&nbsp;<span id="maxCredit">{{CustomerModel.maxTransferCreditLimit == 0 ? '@NGCasinoLang.noLimited' : CustomerModel.maxTransferCreditLimit.formatNumber()}}</span>)</td>                    
        </tr>
    </table>            
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/ptarea.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/CustomerController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/CasinoController.js")" type="text/javascript"></script>   
    <script src="@Url.Content("~/CustomerSetting/Casino/CasinoCustomer/CustomerData/" + id + "/" + uplineId)" type="text/javascript"></script>
     <script type="text/javascript">
        var custId = '@id';
        var uplineId = '@uplineId';

        function toUrl(relativeUrl) {
            return '@Url.Content("~/CustomerSetting/Casino/")' + relativeUrl;
        }
    </script>
</div>