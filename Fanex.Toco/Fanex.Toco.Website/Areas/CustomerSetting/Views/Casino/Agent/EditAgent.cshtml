@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.ViewModels
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using Fanex.CustomerSetting.Module.Casino.Resources
@model CasinoSettingModel
@{
    //var isPtByGameType = true;// For testing purpose only
    var isPtByGameType = Model.IsPtByGameType;
    //Model.IsPtByGameType = isPtByGameType;// For testing purpose only
    var settingModel = JsonConvert.SerializeObject(Model, Formatting.None, new JsonSerializerSettings
        {
            ContractResolver = new CamelCasePropertyNamesContractResolver(),
            NullValueHandling = NullValueHandling.Ignore
        });    
}
<div id="ng-app" style="display: none; width: 1024px" data-ng-app="settingApp">
    <div id="errMsg" style="display: none;" class="successMsg">
    </div>
    <div id="arrowUpDown" class="collapse">
    </div>
    <div id="names" style="display: none;" class="names">
    </div>    
    <div>
        <input class="buttonPopup" type="button" value="Submit" />
    </div>
    <div>
        @Html.Action("CustomerInfo", "CasinoCustomer", new { area = string.Empty, id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]), uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]) })
    </div>
    <div>
        <div class="headerPositionTaking" style="border: 1px solid #ccc; border-top: 0">
            @NGCasinoLang.positiontaking
        </div>                                                                                                                                                                                                                                                                                                                                                            
        <div style="border-right: none" id="settingContainer" data-ng-controller="EditAgentController">
            <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="gameGroupWidth noneBorderL noneBorderTop noneBorderR">&nbsp;</td>
                    <td class="gameTypeWidth noneBorderL noneBorderTop">&nbsp;</td>
                    <td class="ptTitle noneBorderTop tdWidth">@NGCasinoLang.lblMasterPresetPT</td>
                    <td class="ptTitle noneBorderTop autoPtWidth">@NGCasinoLang.lblMasterAutoPT</td>
                    <td class="ptTitle noneBorderTop tdWidth">@NGCasinoLang.lblAgentMaxPT</td>
                    <td class="ptTitle noneBorderTop tdWidth">@NGCasinoLang.lblAgentMinPT</td>
                    <td class="ptTitle noneBorderTop tdWidth">@NGCasinoLang.lblAgentComm</td>
                </tr>
                <tr data-ng-controller="GameGroupController" data-ng-repeat="gameGroup in customer.gameGroups" data-ng-finish-render="rendered">
                    <td class="gameGroupWidth gameTitle noneBorderTop">{{gameGroup.gameGroupName}}</td>
                    <td colspan="6" class="noneBorderBottom noneBorderTop">
                        <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
                            <tr>
                                <td class="gameTypeWidth ptTitle R noneBorderTop noneBorderL">@NGCasinoLang.lblGroupSetting</td>
                                <td class="C ptTitle noneBorderTop tdWidth">
                                    <span data-ng-init="gameGroup.l2 = gameGroup.m3 - gameGroup.m2" data-ng-click="gameGroup.l2 = gameGroup.m3 - gameGroup.m2" class="spanPT"  enable="gameGroup.im2" ptarea="true" min="0" max="m3" selected="m2" data-ng-model="setting"></span>
                                </td>
                                  <td class="C ptTitle noneBorderTop autoPtWidth">
                                    <input type="checkbox" data-ng-model="gameGroup.im2" />
                                    <span enable="gameGroup.im2 == false" class="spanPT" ptarea="true" min="0" max="m3" selected="um2" data-ng-model="setting"></span>
                                </td>
                                <td class="C ptTitle noneBorderTop tdWidth">
                                    <span data-ng-init="gameGroup.l2 = gameGroup.m3 - gameGroup.m2" data-ng-click="gameGroup.l2 = gameGroup.m3 - gameGroup.m2"  class="spanPT"  ptarea="true" min="0" max="l2" selected="a2" data-ng-model="setting"></span>
                                </td>
                                <td class="C ptTitle noneBorderTop tdWidth">
                                    <span class="spanPT" ptarea="true" min="0" max="a2" selected="n2" data-ng-model="setting"></span>
                                </td>
                                <td class="C ptTitle noneBorderTop tdWidth" style="border-right: 0px none">
                                    <span class="spanPT" ptarea="true" min="0" max="mco" selected="aco" data-ng-model="setting" iscomm = "true"></span>
                                </td>
                            </tr>         
                            @if (isPtByGameType)
                            {                
                            <tr data-ng-controller="GameTypeController" data-ng-repeat="gameType in gameGroup.gameTypes">
                                <td colspan="6" style="border: none">
                                    <table class="tableInfo" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <td rowspan="2" class="gameTypeWidth R noneBorderL noneBorderT">
                                                {{gameType.gameTypeName}}
                                            </td>
                                            <td class="C noneBorderT tdWidth">
                                                <span  data-ng-init="gameType.l2 = gameType.m3 - gameType.m2" data-ng-click="gameType.l2 = gameType.m3 - gameType.m2" class="spanPT" enable="gameType.im2" showbutton="false" ptarea="true" min="0" max="l2" selected="m2" data-ng-model="setting"></span>
                                            </td>
                                            <td class="C noneBorderT autoPtWidth">
                                                <input type="checkbox" data-ng-model="gameType.im2" />
                                                    <span enable="gameType.im2 == false" class="spanPT" showbutton="false" ptarea="true" min="0" max="m3" selected="um2" data-ng-model="setting"></span>
                                            </td>
                                            <td class="C noneBorderT maxPtAgentWidth">
                                                <span  data-ng-init="gameType.l2 = gameType.m3 - gameType.m2" data-ng-click="gameType.l2 = gameType.m3 - gameType.m2" class="spanPT" showbutton="false" ptarea="true" min="0" max="l2" selected="a2" data-ng-model="setting"></span>
                                            </td>
                                            <td class="C noneBorderT tdWidth">
                                                <span class="spanPT" showbutton="false" ptarea="true" min="0" max="a2" selected="n2" data-ng-model="setting"></span>
                                            </td>
                                            <td class="noneBorderR C noneBorderT noneBorderRight tdWidth">
                                                <span class="spanPT" showbutton="false" ptarea="true" min="0" max="mco" selected="aco" data-ng-model="setting" iscomm = "true"></span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="4" class="noneBorderRight"><span>@NGCasinoLang.lblBettingLimit: </span>
                                                <span data-ng-controller="BettingLimitController" data-ng-repeat="stake in gameType.bettingLimits">
                                                    <input type="checkbox" data-ng-model="stake.isChecked" /><span>{{stake.stakeLevelName}}</span>
                                                </span>
                                            </td>
                                        </tr>
                                    </table>
                                </td>                    
                            </tr>                
                            }
                            else
                            {
		                    <tr data-ng-controller="GameTypeController" data-ng-repeat="gameType in gameGroup.gameTypes">
                                <td class="gameTypeWidth R noneBorderL">
                                    {{gameType.gameTypeName}}
                                </td>
                                <td colspan="5" class="noneBorderR"><span>@NGCasinoLang.lblBettingLimit: </span>
                                    <span data-ng-controller="BettingLimitController" data-ng-repeat="stake in gameType.bettingLimits">
                                        <input type="checkbox" data-ng-model="stake.isChecked" /><span>{{stake.stakeLevelName}}</span>
                                    </span>
                                </td>
                            </tr>
                            }
                        </table>
                    </td>                    
                </tr>                                        
            </table>            
        </div>
    </div>
    <div>
        <input class="buttonPopup" type="button" value="Submit" />
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/EditAgentController.js")" type="text/javascript"></script>
