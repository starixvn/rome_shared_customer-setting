@using Newtonsoft.Json;
@using Fanex.Module.Statement.Models.StatementReport;
@using Fanex.Module.Statement.Resources;
@model StatementReportModel
@{
    ViewBag.Title = Labels.Transfer_Details;
    Layout = "";
    var statementReport = JsonConvert.SerializeObject(Model);
    var transferDetailsCriteria = JsonConvert.SerializeObject(ViewBag.TransferDetailsCriteria);
}
<!DOCTYPE html>
<html lang="en" class="linen">
<head>
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Scripts/_Libs/FanexGrid/FanexGridStyles")
    <link href="@Url.Content("~/Areas/Statement/Views/StatementDetails/Styles/StatementDetails.css")" rel="stylesheet" type="text/css" />
</head>
<body id="body">
    <div id="transfer-details-container" class="freegrid">
    </div>
    <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js")"></script>
    @Scripts.Render("~/Scripts/_Libs/FanexGrid/FanexGridScripts")
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/moment.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/numeral.js")"></script>
    <script type="text/javascript"src="@Url.Content("~/Areas/Statement/Views/StatementDetails/Scripts/StatementDetailsManager.js")"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';       
        var statementReport= @Html.Raw(statementReport); 
        var transferDetailsCriteria= @Html.Raw(transferDetailsCriteria); 
          var statementResources = {
              Date: '@Labels.Date',
              Remark: '@Labels.Remark',
              Amount: '@Labels.Amount',
              Symbol_NoData: '@Labels.Symbol_NoData',
              Total: '@Labels.Total',
              Symbol_ExchangeRate: '@Labels.Symbol_ExchangeRate',
              Creator: '@Labels.Creator'
          };
    </script>
</body>
</html>
