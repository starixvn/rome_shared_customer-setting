@using Fanex.BetList.Core.Entities;
@using DNAide.Core;
@using Fanex.BetList.Core.Factories;
@using Fanex.BetList.Core.Builder;
@using Fanex.Module.RNGCasino.Models;
@using Fanex.Module.RNGCasino.Helpers;
@using Fanex.CustomerSetting.Module.Core.Extensions;
@using Fanex.Module.RNGCasino.Resources;
@using Sunplus.Agent.Model.Entities;
@{
    TicketDetail betdetail = new TicketDetail();
    int numberBeginning = 1;

    var roleId = UserSession.Current.RoleId;
    string[] renderResult = Render(ref numberBeginning);
}
@functions {
    public string[] Render(ref int numberBeginning)
    {
        var roleId = UserSession.Current.RoleId;
        BetListHelper betlistHelper = new BetListHelper();
        string[] result = new string[2];
        foreach (var ticket in Model)
        {
            result[1] += renderContent(ticket, numberBeginning, betlistHelper, roleId);
            numberBeginning++;
        }

        return result;
    }
}
@helper renderContent(TicketDetail betdetail, int numberBeginning, BetListHelper betlistHelper, int roleId)
{
string statusTemp = betdetail.Ticket.Status.ToLower();
decimal winlost = betdetail.Ticket.Winlost;
decimal playerComm = betdetail.Ticket.PlayerComm;
var ip = betdetail.Ticket.IP;

decimal superPT = betdetail.Ticket.SuperPositionTaking;
decimal superPT2 = betdetail.SuperPositionTaking2;
decimal superDiscount = betdetail.Ticket.SuperDiscount;
decimal superComm = betdetail.Ticket.SuperComm;
decimal superWinlost = betdetail.Ticket.SuperWinlost;
string doubleCom = betdetail.Ticket.CommStatus == "1" ? "2x" : string.Empty;

decimal masterPT = betdetail.Ticket.MasterPositionTaking;
decimal masterPT2 = betdetail.MasterPositionTaking2;
decimal masterDiscount = betdetail.Ticket.MasterDiscount;
decimal masterComm = betdetail.Ticket.AgentComm;
decimal masterWinlost = betdetail.Ticket.MasterWinlost;

decimal agentPT = betdetail.Ticket.AgentPositionTaking;
decimal agentPT2 = betdetail.AgentPositionTaking2;
decimal agentDiscount = betdetail.Ticket.AgentDiscount;
decimal agentComm = betdetail.Ticket.Comm;
decimal agentWinlost = betdetail.Ticket.AgentWinlost;

var isShowWinLoss = statusTemp != "running";
    <tr class="c">
        <td>
            <div class="c width30 table-cell">
                @numberBeginning
            </div>
        </td>
        <td class="c column-transdate">
            <div class="width120 table-cell">
                @Html.Raw(betdetail.TransDateHtml)
            </div>
        </td>
        <td id="td_right_@betdetail.Ticket.TransId" class='r bl_evt'>
            <div id="choice_right_@betdetail.Ticket.TransId" class="column-choice table-cell">
                @Html.Raw(betdetail.ChoiceHtml)
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width60 table-cell">
                @Html.Raw(betdetail.OddHtml)
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width50 table-cell">
                @Html.Raw(betdetail.StakeHtml)
            </div>
        </td>
        <td class="r">
            <div class="column-winloss table-cell">
                @if (statusTemp == "running" || statusTemp == "waiting")
                {
                    <div class="margin-top-5">
                        -
                    </div>
                }
                else if (statusTemp == "void" || statusTemp == "reject")
                {
                    <div class="margin-top-5">
                        0.00
                    </div>
                }
                else
                {
                    <div>
                        <div class="@betlistHelper.IsNegative(betdetail.Ticket.Winlost) margin-top-5">
                            @winlost.Format(2)
                        </div>
                        <div class="margin-top-5">
                            @playerComm.Format(2)
                        </div>
                    </div>
                }
            </div>
        </td>
        <td class="c">
            <div id="stautus_@betdetail.Ticket.TransId" class="width100 table-cell">
                @Html.Raw(betdetail.StatusHtml)
                @if (ip != "-")
                {
                    <br />
                    <div class="iplink" onclick="OpenIPInfo('@betdetail.Ticket.IP');">@ip</div>
                }
            </div>
        </td>
        @if (roleId >= 4)
        {
            <td class="r">
                <div id="comm_@betdetail.Ticket.TransId" class="width60 table-cell">
                    <div class="div_pt">
                        <div class="@betlistHelper.IsNegative(superPT)">
                            <span>@betlistHelper.PercentFormat(superPT)</span>
                        </div>

                        @if (isShowWinLoss)
                        {
                            <div class="@betlistHelper.IsNegative(superWinlost) margin-top-5">
                                @superWinlost.Format(2)
                            </div>
                        }
                    </div>
                    <div class="margin-top-5">
                        <span>@doubleCom @betlistHelper.PercentFormat(superDiscount)</span>
                    </div>
                    @if (isShowWinLoss)
                    {
                        <div class="margin-top-5">
                            @superComm.Format(2)
                        </div>
                    }
                </div>
            </td>
        }
        @if (roleId >= 3)
        {
            <td class="r">
                <div class="width60 table-cell">
                    <div class="div_pt">
                        <div class="@betlistHelper.IsNegative(masterPT)">
                            <span>@betlistHelper.PercentFormat(masterPT)</span>
                        </div>

                        @if (isShowWinLoss)
                        {
                            <div class="@betlistHelper.IsNegative(masterWinlost) margin-top-5">
                                @masterWinlost.Format(2)
                            </div>
                        }
                    </div>
                    <div class="margin-top-5">
                        <span>@doubleCom @betlistHelper.PercentFormat(masterDiscount)</span>
                    </div>
                    @if (isShowWinLoss)
                    {
                        <div class="margin-top-5">
                            @masterComm.Format(2)
                        </div>
                    }
                </div>
            </td>
        }
        <td class="r">
            <div class="width60 table-cell">
                <div class="div_pt">
                    <div class="@betlistHelper.IsNegative(agentPT)">
                        <span>@betlistHelper.PercentFormat(agentPT)</span>
                    </div>

                    @if (isShowWinLoss)
                    {
                        <div class="@betlistHelper.IsNegative(agentWinlost) margin-top-5">
                            @agentWinlost.Format(2)
                        </div>
                    }
                </div>
                <div class="margin-top-5">
                    <span>@doubleCom @betlistHelper.PercentFormat(agentDiscount)</span>
                </div>
                @if (isShowWinLoss)
                {
                    <div class="margin-top-5">
                        @agentComm.Format(2)
                    </div>
                }
            </div>
        </td>
    </tr>
}
<html>
<head>
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Apo/Common/Agent.min.css")?v=@(Sunplus.Agent.Model.BL.Definitions.AppSettings.JsVersion)" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Apo/BetList/BetList.min.css")?v=@(Sunplus.Agent.Model.BL.Definitions.AppSettings.JsVersion)" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Apo/RNGCasino/BetDetails/BetDetails.min.css")?v=@(Sunplus.Agent.Model.BL.Definitions.AppSettings.JsVersion)" />
    <title>@BetListResources.Product_6</title>
</head>
<body>
    <div id="betlist-details" class="freegrid display-none">
        <table id="hor-minimalist-a">
            <thead>
                <tr>
                    <th class="col-number">
                        #
                    </th>
                    <th class="col-transtime">
                        @BetListResources.Trans_Time
                    </th>
                    <th>
                        @BetListResources.Choice
                    </th>
                    <th class="col-odds">
                        @BetListResources.Odds
                    </th>
                    <th class="col-stake">
                        @BetListResources.Stake
                    </th>
                    <th class="col-Win_Loss">
                        @BetListResources.Win_Loss
                    </th>
                    <th class="col-Status">
                        @BetListResources.Status
                    </th>
                    @if (roleId >= 4)
                    {
                        <th class="col-type">
                            @BetListResources.Super
                            <br />
                            @BetListResources.PT/@BetListResources.Comm
                        </th>
                    }
                    @if (roleId >= 3)
                    {
                        <th class="col-type">
                            @BetListResources.Master
                            <br />
                            @BetListResources.PT/@BetListResources.Comm
                        </th>
                    }
                    <th class="col-type">
                        @BetListResources.Agent
                        <br />
                        @BetListResources.PT/@BetListResources.Comm
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    betdetail = Model[0];
                    @MvcHtmlString.Create(renderResult[1])
                }
                else
                {
                    <tr class="c">
                        <td colspan="10" class="r column-no-data">
                            <div class="c b">
                                @BetListResources.ThereIsNoData
                            </div>
                        </td>
                    </tr>
                    betdetail.Ticket = new Ticket { CustId = 0 };
                }
            </tbody>
        </table>
    </div>
    <script type="text/javascript" src="~/_GlobalResources/Js/Core.js"></script>
    <script type="text/javascript" src="~/_Components/AGEWnd/AGEWnd.js"></script>
    <script type="text/javascript" src="~/js/Common.js"></script>
    <script type="text/javascript">
        var roleId= @UserSession.Current.RoleId;
        function ViewRNGCasinoResult(matchId, race, betType, sportType, refNo, winlostDate) {
            var width = 835;
            var height = 675;
            var params = 'matchid=' + matchId +
                '&bettype=' + betType +
                '&race=' + race +
                '&sportId=' + sportType +
                '&refNo=' + refNo +
                '&roleId=' +roleId +
                '&winlostDate=' + winlostDate;

            new AGEWnd(top.document).open(age.GetBaseUrl() + 'RNGCasinoBetList/GetHandHistory?' + params, '', 350, 200, width, height);
        }

        function ViewRNGCasinoBrokenGame(matchId, race, betType, sportType, refNo, winlostDate) {
            var width = 835;
            var height = 675;
            var params = 'matchid=' + matchId +
                '&bettype=' + betType +
                '&race=' + race +
                '&sportId=' + sportType +
                '&refNo=' + refNo +
                '&roleId=' + roleId +
                '&winlostDate=' + winlostDate;

            new AGEWnd(top.document).open(age.GetBaseUrl() + 'RNGCasinoBetList/GetHandHistory?' + params, '', 350, 200, width, height);

            //if (parent.ageWnd) {
            //    parent.ageWnd.open(age.GetBaseUrl() + 'RNGCasinoBetList/GetHandHistory?' + params, '', 50, 100, width, height);
            //}
            //else {
            //    ageWnd.open(age.GetBaseUrl() + 'RNGCasinoBetList/GetHandHistory?' + params, '', 50, 100, width, height);
            //}
        }
    </script>
</body>
</html>
